<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <!-- [VidaReal] 19.x: versión desde Directory.Build.props (como upstream). AssemblyTitle viene de Properties/AssemblyInfo.cs. -->
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <RockWebPath>..\RockWeb</RockWebPath>
    <CopyToRockWeb>True</CopyToRockWeb>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="RestSharp" Version="105.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rock.Common\Rock.Common.csproj" />
    <ProjectReference Include="..\Rock.Enums\Rock.Enums.csproj" />
    <ProjectReference Include="..\Rock\Rock.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <!-- Used to downscale / re-encode images that exceed WhatsApp's 5 MB limit. -->
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
