<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<!--
    Panel de uso de los códigos QR.
    Todos los gráficos son SVG inline: una sola serie de magnitud cada uno, así que llevan un
    solo tono (#1E5B87) y la identidad la carga la etiqueta de cada fila, no el color. Por eso
    no hay paleta categórica — la de marca falla la validación como categórica (navy muy oscuro,
    acero muy claro) y no hace falta para magnitud.
    El <style> es NO-scoped a propósito: targetea .panel-block, chrome de Rock fuera del template.
-->
<template>
    <Panel type="block" title="" class="qrm-panel">
        <div class="qrmWrap">
            <div v-if="notAuthorized" class="qrmPage">
                <NotificationBox alertType="warning">No tenés permiso para ver las métricas.</NotificationBox>
            </div>

            <div v-else class="qrmPage">
                <nav class="qrNav" aria-label="Secciones del módulo QR">
                    <a v-if="options.catalogPageUrl" :href="options.catalogPageUrl">Catálogo</a>
                    <a v-if="options.dashboardPageUrl" :href="options.dashboardPageUrl">Reportería</a>
                    <span class="qrNavOn" aria-current="page">Uso</span>
                </nav>

                <header class="qrmHead">
                    <div>
                        <h1 class="qrmTitle">Uso de códigos QR</h1>
                        <p class="qrmSub">{{ rangeText }}</p>
                    </div>
                    <div class="qrmRange">
                        <!-- El selector iba con label="" y quedaba sin nombre accesible. La etiqueta
                             va acá y no en el control porque el `for` que arma RockFormField apunta
                             a un id generado que nadie lleva; el `id` que se le pasa al DropDownList
                             sí baja hasta el input role=combobox, así que esta asociación es real. -->
                        <label class="qrmSrOnly" for="qrmRangeSelect">Rango de fechas</label>
                        <DropDownList id="qrmRangeSelect" v-model="rangeDays" label=""
                                      :items="rangeItems" :showBlankItem="false" />
                    </div>
                </header>

                <!-- ===== Qué se está mirando =====
                     Con cientos de códigos, elegir uno de un desplegable obliga a saberse el nombre.
                     Se elige desde la tabla de abajo (buscar, filtrar, ordenar por escaneos) o desde
                     el top; acá solo se dice qué se está viendo y cómo volver. -->
                <div v-if="hasDynamicCodes" class="qrmFocus" :class="{ qrmFocusOn: selected }">
                    <template v-if="selected">
                        <span class="qrmFocusLbl">Viendo solo</span>
                        <strong class="qrmFocusName">{{ selected.name }}</strong>
                        <span v-if="selected.categoryName" class="qrmTag">{{ selected.categoryName }}</span>
                        <a v-if="options.detailPageUrl" class="qrmLink qrmFocusLink" :href="hrefFor(selected)">Abrir el código</a>
                        <button type="button" class="qrmFocusBtn" @click="selectCode('')">× Ver todos los códigos</button>
                    </template>
                    <template v-else>
                        <span class="qrmFocusLbl">Mostrando los {{ fmt(allCodes.length) }} códigos dinámicos.</span>
                        <button type="button" class="qrmFocusBtn" @click="goToCodes">Buscar un código específico ↓</button>
                    </template>
                </div>

                <!-- Región viva siempre presente: un aria-live que nace junto con su texto no se
                     anuncia, y NotificationBox no trae ninguno propio. -->
                <div class="qrmLive" aria-live="polite" aria-atomic="true">
                    <NotificationBox v-if="errorMessage" alertType="danger">{{ errorMessage }}</NotificationBox>
                </div>

                <!-- ===== KPIs: números, no gráficos =====
                     Se ocultan cuando no hay un solo código dinámico: cinco ceros no informan nada
                     y hacen creer que el problema es el rango. -->
                <div v-if="hasDynamicCodes" class="qrmKpis">
                    <div class="qrmKpi">
                        <span class="qrmKpiNum">{{ fmt(data.totalScans) }}</span>
                        <span class="qrmKpiLbl">escaneos</span>
                    </div>
                    <!-- Con un código filtrado, "códigos activos" y "dormidos" valdrían 0 o 1: se
                         cambian por lo que sí dice algo de un código suelto. -->
                    <template v-if="selected">
                        <div class="qrmKpi">
                            <span class="qrmKpiNum qrmKpiNumSm">{{ selected.lastScanDateTime ? shortDate(selected.lastScanDateTime) : "—" }}</span>
                            <span class="qrmKpiLbl">último escaneo</span>
                        </div>
                        <div class="qrmKpi" :class="{ qrmKpiAlert: selected.isStale }">
                            <span class="qrmKpiNum qrmKpiNumSm">{{ selectedStatus }}</span>
                            <span class="qrmKpiLbl">estado</span>
                        </div>
                    </template>
                    <template v-else>
                        <div class="qrmKpi">
                            <span class="qrmKpiNum">{{ fmt(data.activeCodes) }}</span>
                            <span class="qrmKpiLbl">códigos activos</span>
                        </div>
                        <div class="qrmKpi" :class="{ qrmKpiAlert: data.staleCodes > 0 }">
                            <span class="qrmKpiNum">{{ fmt(data.staleCodes) }}</span>
                            <span class="qrmKpiLbl">dormidos · {{ options.staleDays }} días</span>
                        </div>
                    </template>
                    <div class="qrmKpi">
                        <span class="qrmKpiNum">{{ fmt(data.distinctCountries) }}</span>
                        <span class="qrmKpiLbl">países</span>
                    </div>
                    <div class="qrmKpi">
                        <span class="qrmKpiNum">{{ identifiedPct }}%</span>
                        <span class="qrmKpiLbl">identificados</span>
                    </div>
                </div>

                <NotificationBox v-if="data.qualityNote" alertType="info">{{ data.qualityNote }}</NotificationBox>

                <!-- Estado vacío honesto: sin dinámicos no faltan escaneos "en este rango",
                     falta el tipo de código que los deja. Mandar a cambiar el rango es mentir. -->
                <div v-if="!hasDynamicCodes" class="qrmEmpty">
                    <p class="qrmEmptyText">Ningún código del catálogo es dinámico, y solo los
                        dinámicos dejan escaneos. Creá uno para empezar a medir.</p>
                    <a v-if="newCodeUrl" class="qrmLink qrmEmptyLink" :href="newCodeUrl">Crear un código dinámico</a>
                </div>

                <div v-else-if="data.totalScans === 0" class="qrmEmpty">
                    <p class="qrmEmptyText">{{ selected
                        ? "Este código no tiene escaneos registrados en este rango."
                        : "Todavía no hay escaneos registrados en este rango." }}</p>
                </div>

                <template v-else>
                    <!-- ===== Serie temporal ===== -->
                    <section class="qrmCard">
                        <h2 class="qrmH2">{{ timelineTitle }}</h2>
                        <div class="qrmChart" @mouseleave="hoverDay = null">
                            <svg :viewBox="`0 0 ${TL_W} ${TL_H}`" preserveAspectRatio="none" class="qrmSvg"
                                 role="group" :aria-label="timelineTitle">
                                <!-- El dibujo va en su propio grupo con role=img, no en el svg
                                     entero: role=img poda TODO lo que tiene adentro del árbol de
                                     accesibilidad, y las zonas de hover de abajo son enfocables.
                                     Puesto en el svg las habría borrado para el lector. -->
                                <g role="img" :aria-label="timelineSummary">
                                    <!-- Grilla recesiva -->
                                    <line v-for="g in timelineGrid" :key="'g'+g.y"
                                          :x1="0" :y1="g.y" :x2="TL_W" :y2="g.y" class="qrmGrid" />

                                    <!-- Un solo día: una polilínea de un punto no dibuja NADA y el
                                         gráfico sale en blanco aunque haya dato. -->
                                    <circle v-if="tlMode === 'point'" :cx="TL_W / 2" :cy="tlY(timeline[0].count)"
                                            r="6" class="qrmDot" />

                                    <!-- Pocos días: barras. Una línea de dos o tres vértices sugiere una
                                         tendencia que con tan pocos datos no existe. -->
                                    <template v-else-if="tlMode === 'bars'">
                                        <rect v-for="(p, i) in timeline" :key="'b'+i"
                                              :x="tlBandX(i) + tlBandW * 0.2" :y="tlY(p.count)"
                                              :width="tlBandW * 0.6" :height="TL_H - tlY(p.count)" class="qrmBarMark" />
                                    </template>

                                    <polyline v-else :points="timelinePoints" class="qrmLine" />
                                </g>

                                <!-- Zonas de hover: más anchas que la marca. Son las MISMAS en los
                                     tres modos (punto, barras, línea), así que enfocarlas deja
                                     accesible cualquiera de los tres. tabindex 0 + focus/blur
                                     replican el mouseenter: antes el detalle solo existía con
                                     mouse. -->
                                <rect v-for="(p, i) in timeline" :key="'h'+i"
                                      :x="hitX(i)" y="0" :width="hitW" :height="TL_H"
                                      class="qrmHit" tabindex="0" role="img" :aria-label="pointLabel(i)"
                                      @mouseenter="hoverDay = i"
                                      @focus="hoverDay = i"
                                      @blur="hoverDay = null" />
                                <circle v-if="hoverDay !== null && tlMode === 'line'"
                                        :cx="tlX(hoverDay)" :cy="tlY(timeline[hoverDay].count)"
                                        r="4" class="qrmDot" />
                            </svg>
                            <div class="qrmAxis" aria-hidden="true">
                                <span>{{ shortDate(timeline[0]?.date) }}</span>
                                <span>{{ shortDate(timeline[timeline.length - 1]?.date) }}</span>
                            </div>
                            <!-- El rótulo cambia con la agrupación: un pico semanal leído como
                                 diario se equivoca por un orden de magnitud. -->
                            <div v-if="hoverDay !== null" class="qrmTip">
                                <strong>{{ fmt(timeline[hoverDay].count) }}</strong> escaneos ·
                                {{ isWeekly ? "semana del " : "" }}{{ longDate(timeline[hoverDay].date) }}
                            </div>
                            <!-- El pico con su fecha, visible y en texto: antes el máximo estaba
                                 acá pero sin decir cuándo, y el cuándo solo se conseguía con el
                                 cursor encima. -->
                            <div v-else class="qrmTip qrmTipIdle">
                                Máximo {{ fmt(peakPoint?.count ?? 0) }}
                                {{ isWeekly ? "en la semana del" : "el" }} {{ longDate(peakPoint?.date) }} ·
                                pasá el cursor o recorré la serie con el tabulador para ver el detalle
                            </div>
                        </div>
                    </section>

                    <div class="qrmGrid2">
                        <!-- ===== Top de códigos =====
                             El top y los dormidos comparan códigos entre sí: con uno solo filtrado
                             no hay nada que comparar, y su estado ya está en los KPIs. -->
                        <section v-if="!selected" class="qrmCard">
                            <h2 class="qrmH2">Más escaneados</h2>
                            <!-- camelCase obligatorio: los attrs de un componente funcional NO se
                                 camelizan, así que :href-for llegaba como undefined. -->
                            <BarList :rows="topRows" :onPick="pickRow" />
                            <p v-if="topNote" class="qrmNote">{{ topNote }}</p>
                        </section>

                        <!-- ===== Dormidos ===== -->
                        <section v-if="!selected" class="qrmCard">
                            <h2 class="qrmH2">Dormidos</h2>
                            <p class="qrmNote">Material impreso que nadie está usando. Es la lista que justifica
                                retirar o reemplazar.</p>
                            <div v-if="data.staleList.length === 0" class="qrmNone">Ninguno. Todos los códigos
                                tuvieron actividad reciente.</div>
                            <ul v-else class="qrmStale">
                                <li v-for="row in data.staleList" :key="row.idKey ?? row.name ?? ''">
                                    <a v-if="options.detailPageUrl" class="qrmLink" :href="hrefFor(row)">{{ row.name }}</a>
                                    <span v-else>{{ row.name }}</span>
                                    <span class="qrmStaleWhen">{{ row.lastScanDateTime
                                        ? 'último ' + shortDate(row.lastScanDateTime)
                                        : 'nunca escaneado' }}</span>
                                </li>
                            </ul>
                        </section>

                        <!-- ===== Dispositivo ===== -->
                        <section class="qrmCard">
                            <h2 class="qrmH2">Dispositivo</h2>
                            <BarList :rows="clientRows" />
                            <h2 class="qrmH2 qrmH2Sep">Sistema operativo</h2>
                            <BarList :rows="osRows" />
                            <p v-if="osNote" class="qrmNote">{{ osNote }}</p>
                        </section>

                        <!-- ===== Procedencia ===== -->
                        <section class="qrmCard">
                            <h2 class="qrmH2">Desde dónde se escaneó</h2>
                            <NotificationBox v-if="!data.geoAvailable" alertType="info">
                                La base de geolocalización no está disponible, así que no se puede resolver la
                                procedencia. Los escaneos igual quedaron registrados.
                            </NotificationBox>
                            <template v-else>
                                <BarList :rows="countryRows" />
                                <p v-if="countryNote" class="qrmNote">{{ countryNote }}</p>

                                <!-- Fuera del ranking a propósito: no es un país, es la parte de los
                                     escaneos que quedó sin resolver. Tampoco se descarta, porque
                                     entonces el total dejaría de cuadrar con los escaneos. -->
                                <div v-if="unresolvedGeo" class="qrmUnresolved">
                                    <span>{{ unresolvedGeo.countryName }}</span>
                                    <span class="qrmUnresolvedVal">{{ fmt(unresolvedGeo.count) }}</span>
                                </div>

                                <template v-if="data.byCity.length">
                                    <h2 class="qrmH2 qrmH2Sep">Ciudades · {{ topCountryName }}</h2>
                                    <BarList :rows="cityRows" />
                                    <p v-if="cityNote" class="qrmNote">{{ cityNote }}</p>
                                </template>
                            </template>
                            <p class="qrmNote">Se deriva de la IP de cada escaneo y se muestra solo agregado.
                                Una IP ubica al proveedor, no a la persona.</p>
                            <p v-if="unresolvedGeo" class="qrmNote">La procedencia es una muestra: se
                                resuelven hasta 500 IP distintas por carga, las de más escaneos. Lo que
                                queda afuera se cuenta arriba como no resuelto, y es distinto de
                                «Desconocido», que significa que sí se consultó y no se pudo ubicar.</p>
                        </section>
                    </div>

                    <div class="qrmActions">
                        <RockButton btnType="default" class="qrmBtn" @click="onExport">Exportar CSV</RockButton>
                    </div>
                </template>

                <!-- ===== Todos los códigos =====
                     Es el selector del panel. Fuera del bloque de gráficos a propósito: un código
                     sin escaneos en el rango igual tiene que poder elegirse (para confirmar que no
                     se usa), y con el panel vacío esta tabla es lo único útil que queda. -->
                <section v-if="hasDynamicCodes" id="qrmCodes" class="qrmCard qrmCodes">
                    <h2 class="qrmH2">Todos los códigos</h2>
                    <p class="qrmNote">Elegí un código para ver sus métricas en todo el panel. Los
                        escaneos son del rango elegido arriba.</p>

                    <div class="qrmCodeFilters">
                        <div ref="codeSearchWrap">
                            <TextBox v-model="codeSearch" label="Buscar" placeholder="Nombre o categoría" class="qrmInput" />
                        </div>
                        <DropDownList v-model="codeCategory" label="Categoría" class="qrmInput"
                                      :items="categoryItems" showBlankItem />
                        <DropDownList v-model="codeSort" label="Ordenar por" class="qrmInput"
                                      :items="codeSortItems" :showBlankItem="false" />
                        <CheckBox v-model="codeShowInactive" label="Incluir inactivos" />
                    </div>

                    <div v-if="filteredCodes.length === 0" class="qrmNone">Ningún código coincide con la búsqueda.</div>

                    <div v-else class="qrmTableWrap" tabindex="0" role="group" aria-label="Tabla de códigos, desplazable">
                        <table class="qrmTable">
                            <caption class="qrmSrOnly">{{ codesCaption }}</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Código</th>
                                    <th scope="col" class="qrmNum">Escaneos</th>
                                    <th scope="col">Último escaneo</th>
                                    <th scope="col"><span class="qrmSrOnly">Acción</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="row in pagedCodes" :key="row.idKey ?? row.name ?? ''"
                                    class="qrmRow"
                                    :class="{ qrmRowOn: row.idKey === selected?.idKey, qrmRowOff: !row.isActive }"
                                    @click="pickRow(row)">
                                    <td>
                                        <span class="qrmRowName">{{ row.name }}</span>
                                        <span v-if="row.categoryName" class="qrmTag">{{ row.categoryName }}</span>
                                        <span v-if="!row.isActive" class="qrmTag qrmTagOff">inactivo</span>
                                        <span v-else-if="row.isStale" class="qrmTag qrmTagWarn">dormido</span>
                                    </td>
                                    <td class="qrmNum">
                                        <span class="qrmRowCount">{{ fmt(row.count) }}</span>
                                        <!-- Barra contra el máximo del catálogo, no de la página:
                                             si no, la primera fila de cada página llegaría al 100 %. -->
                                        <span class="qrmRowTrack" aria-hidden="true">
                                            <span class="qrmRowFill" :style="{ width: rowPct(row) + '%' }"></span>
                                        </span>
                                    </td>
                                    <td>{{ row.lastScanDateTime ? shortDate(row.lastScanDateTime) : "nunca" }}</td>
                                    <td class="qrmNum">
                                        <!-- El botón es el control accesible; el clic en la fila es
                                             atajo de mouse. stop: sin él, el clic llega dos veces. -->
                                        <button v-if="row.idKey !== selected?.idKey" type="button" class="qrmRowBtn"
                                                @click.stop="pickRow(row)">Ver métricas</button>
                                        <span v-else class="qrmRowHere">viendo</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div v-if="pageCount > 1" class="qrmPager">
                        <button type="button" class="qrmRowBtn" :disabled="codePage === 0" @click="codePage--">← Anterior</button>
                        <span class="qrmPagerText">{{ pageRangeText }}</span>
                        <button type="button" class="qrmRowBtn" :disabled="codePage >= pageCount - 1" @click="codePage++">Siguiente →</button>
                    </div>
                </section>
            </div>
        </div>
    </Panel>
</template>

<style>
/* Fuentes Brújula VR servidas desde RockWeb (no CDN). Blogger Sans es CC BY-ND: formato original. */
@font-face {
    font-family: "Blogger Sans";
    src: url("/Assets/Fonts/BrujulaVR/BloggerSans-Regular.otf") format("opentype");
    font-weight: 400; font-style: normal; font-display: swap;
}
@font-face {
    font-family: "Blogger Sans";
    src: url("/Assets/Fonts/BrujulaVR/BloggerSans-Bold.otf") format("opentype");
    font-weight: 700; font-style: normal; font-display: swap;
}
@font-face {
    font-family: "Fira Sans";
    src: url("/Assets/Fonts/BrujulaVR/FiraSans-Regular.woff2") format("woff2"), url("/Assets/Fonts/BrujulaVR/FiraSans-Regular.ttf") format("truetype");
    font-weight: 400; font-style: normal; font-display: swap;
}
@font-face {
    font-family: "Fira Sans";
    src: url("/Assets/Fonts/BrujulaVR/FiraSans-Medium.woff2") format("woff2"), url("/Assets/Fonts/BrujulaVR/FiraSans-Medium.ttf") format("truetype");
    font-weight: 500; font-style: normal; font-display: swap;
}
@font-face {
    font-family: "Fira Sans";
    src: url("/Assets/Fonts/BrujulaVR/FiraSans-SemiBold.woff2") format("woff2"), url("/Assets/Fonts/BrujulaVR/FiraSans-SemiBold.ttf") format("truetype");
    font-weight: 600; font-style: normal; font-display: swap;
}
@font-face {
    font-family: "Fira Mono";
    src: url("/Assets/Fonts/BrujulaVR/FiraMono-Regular.woff2") format("woff2"), url("/Assets/Fonts/BrujulaVR/FiraMono-Regular.ttf") format("truetype");
    font-weight: 400; font-style: normal; font-display: swap;
}

/* Chrome del panel: solo para este bloque. */
.panel-block:has(.qrmWrap) > .panel-heading,
.panel-block:has(.qrmWrap) > .panel-header { display: none !important; }
.panel-block:has(.qrmWrap) {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    margin: 0 !important;
    padding: 0 !important;
}
.panel-block:has(.qrmWrap) > .panel-body { padding: 0 !important; }

.qrmWrap {
    /* Tokens Brújula VR */
    --vr-navy: #0F334B;
    --vr-red: #E74133;
    --bg: #F3F5F7;
    --paper: #FFFFFF;
    --paper-alt: #F8FAFB;
    --ink: #0F334B;
    --ink-soft: #5A6E7C;
    /* #8296A6 daba 3,06:1 sobre blanco y acá se usa en texto de 10-12 px (etiquetas de KPI,
       notas, ejes): no pasa AA. Este tono da ~5,1:1 y sigue leyéndose recesivo. */
    --ink-faint: #5E6E7A;
    --rule: #E1E8ED;
    --rule-strong: #C9D4DC;
    --action: #1E5B87;       /* el único tono de las marcas: pasa contraste >=3:1 */
    --action-soft: #EAF1F6;
    --steel: #A2BACA;        /* solo grilla y ejes: recesivo a propósito */
    --warn-text: #8F5B0B;
    --warn-bg: #FDF2E1;
    --shadow-card: 0 1px 2px rgba(15,51,75,.06), 0 2px 8px rgba(15,51,75,.05);
    --radius-sm: 6px;
    --radius: 10px;
    --font-title: "Blogger Sans", "Century Gothic", Futura, sans-serif;
    --font-body: "Fira Sans", "Segoe UI", system-ui, sans-serif;
    --font-num: "Fira Mono", "Fira Sans", Consolas, monospace;

    font-family: var(--font-body);
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
}
.qrmWrap *, .qrmWrap *::before, .qrmWrap *::after { box-sizing: border-box; }

.qrmPage { margin: 0 -15px; background: var(--bg); padding: 24px 20px 32px; min-height: 50vh; }


/* Navegación entre las páginas del módulo. Hace falta porque el menú de Rock 18 solo muestra
   dos niveles y estas páginas son nietas de Digital Tools: por el menú no se llega. */
.qrNav { display: flex; gap: 4px; margin-bottom: 16px; border-bottom: 1px solid var(--rule); }
.qrNav a, .qrNav span { padding: 8px 14px; font-size: 13px; text-decoration: none; border-bottom: 2px solid transparent; margin-bottom: -1px; }
.qrNav a { color: var(--ink-soft); }
.qrNav a:hover { color: var(--action); }
.qrNavOn { color: var(--vr-navy); font-weight: 600; border-bottom-color: var(--vr-navy) !important; }

.qrmHead { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
.qrmTitle { font-family: var(--font-title); font-weight: 700; font-size: 26px; color: var(--vr-navy); margin: 0; }
.qrmSub { color: var(--ink-soft); font-size: 13px; margin: 4px 0 0; }
.qrmRange { min-width: 190px; }
.qrmHead > div:first-child { flex: 1; min-width: 0; }
.qrmKpiNumSm { font-size: 20px; line-height: 1.4; }

/* ===== Qué se está mirando ===== */
.qrmFocus { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; background: var(--paper); border: 1px solid var(--rule); border-radius: var(--radius); padding: 10px 14px; margin-bottom: 14px; font-size: 13px; }
.qrmFocusOn { background: var(--action-soft); border-color: var(--action); }
.qrmFocusLbl { color: var(--ink-soft); }
.qrmFocusName { color: var(--vr-navy); font-size: 15px; }
.qrmFocusLink { font-size: 13px; }
.qrmFocusBtn { margin-left: auto; background: none; border: 1px solid var(--rule-strong); border-radius: var(--radius-sm); padding: 5px 10px; font-size: 12px; font-weight: 600; color: var(--action); cursor: pointer; }
.qrmFocusBtn:hover { background: var(--paper-alt); }
.qrmTag { display: inline-block; font-size: 10px; text-transform: uppercase; letter-spacing: .04em; padding: 2px 7px; border-radius: 999px; background: var(--action-soft); color: var(--action); margin-left: 6px; white-space: nowrap; vertical-align: middle; }
.qrmTagOff { background: #FBE3E0; color: var(--vr-red); }
.qrmTagWarn { background: var(--warn-bg); color: var(--warn-text); }

/* ===== Top: el nombre filtra el panel ===== */
.qrmBarPick { background: none; border: 0; padding: 0; text-align: left; color: var(--action); font-weight: 600; cursor: pointer; }
.qrmBarPick:hover { text-decoration: underline; }

/* ===== Todos los códigos ===== */
.qrmCodes { margin-top: 16px; }
.qrmCodeFilters { display: grid; grid-template-columns: 2fr 1fr 1fr auto; gap: 12px; align-items: end; margin: 10px 0 12px; }
.qrmTableWrap { overflow-x: auto; border: 1px solid var(--rule); border-radius: var(--radius-sm); }
.qrmTable { width: 100%; border-collapse: collapse; font-size: 13px; }
.qrmTable thead th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--ink-faint); font-weight: 600; padding: 10px 12px; border-bottom: 1px solid var(--rule-strong); white-space: nowrap; }
.qrmTable tbody td { padding: 9px 12px; border-bottom: 1px solid var(--rule); vertical-align: middle; }
.qrmTable tbody tr:last-child td { border-bottom: none; }
.qrmTable .qrmNum { text-align: right; white-space: nowrap; }
.qrmRow { cursor: pointer; }
.qrmRow:hover { background: var(--paper-alt); }
.qrmRowOn, .qrmRowOn:hover { background: var(--action-soft); }
.qrmRowOff { opacity: .6; }
.qrmRowName { font-weight: 600; color: var(--ink); }
.qrmRowCount { font-family: var(--font-num); color: var(--vr-navy); display: inline-block; min-width: 40px; }
.qrmRowTrack { display: inline-block; width: 80px; height: 6px; background: var(--paper-alt); border-radius: 3px; margin-left: 8px; vertical-align: middle; overflow: hidden; }
.qrmRowFill { display: block; height: 100%; background: #1E5B87; }
.qrmRowBtn { background: none; border: 1px solid var(--rule-strong); border-radius: var(--radius-sm); padding: 4px 10px; font-size: 12px; font-weight: 600; color: var(--action); cursor: pointer; white-space: nowrap; }
.qrmRowBtn:hover:not(:disabled) { background: var(--paper-alt); }
.qrmRowBtn:disabled { opacity: .4; cursor: default; }
.qrmRowHere { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--action); font-weight: 600; }
.qrmPager { display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 12px; }
.qrmPagerText { font-size: 12px; color: var(--ink-soft); font-family: var(--font-num); }

.qrmKpis { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin-bottom: 16px; }
.qrmKpi { background: var(--paper); border: 1px solid var(--rule); border-radius: var(--radius); padding: 14px 16px; box-shadow: var(--shadow-card); }
.qrmKpiAlert { background: var(--warn-bg); border-color: #F0DCBB; }
.qrmKpiNum { display: block; font-family: var(--font-num); font-size: 26px; color: var(--vr-navy); line-height: 1.1; }
.qrmKpiAlert .qrmKpiNum { color: var(--warn-text); }
.qrmKpiLbl { display: block; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--ink-faint); margin-top: 3px; }

.qrmCard { background: var(--paper); border: 1px solid var(--rule); border-radius: var(--radius); padding: 18px 20px; box-shadow: var(--shadow-card); margin-bottom: 16px; }
.qrmGrid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start; }
.qrmGrid2 .qrmCard { margin-bottom: 0; }
.qrmH2 { font-family: var(--font-title); font-weight: 700; font-size: 15px; color: var(--vr-navy); margin: 0 0 12px; }
.qrmH2Sep { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--rule); }
.qrmNote { font-size: 11px; color: var(--ink-faint); line-height: 1.5; margin: 10px 0 0; }
.qrmNone { font-size: 12px; color: var(--ink-faint); font-style: italic; padding: 8px 0; }

/* Serie temporal */
.qrmChart { position: relative; }
.qrmSvg { width: 100%; height: 160px; display: block; overflow: visible; }
.qrmGrid { stroke: var(--steel); stroke-width: 1; opacity: .45; vector-effect: non-scaling-stroke; }
.qrmLine { fill: none; stroke: var(--action); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
.qrmBarMark { fill: var(--action); }
.qrmDot { fill: var(--action); stroke: var(--paper); stroke-width: 2; vector-effect: non-scaling-stroke; }
.qrmHit { fill: transparent; cursor: crosshair; }
.qrmAxis { display: flex; justify-content: space-between; font-size: 11px; color: var(--ink-faint); margin-top: 6px; font-family: var(--font-num); }
.qrmTip { font-size: 12px; color: var(--ink-soft); margin-top: 8px; min-height: 18px; }
.qrmTipIdle { color: var(--ink-faint); }

/* Barras horizontales */
.qrmBars { list-style: none; margin: 0; padding: 0; }
.qrmBar { margin-bottom: 10px; }
.qrmBarTop { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; font-size: 12px; margin-bottom: 3px; }
.qrmBarName { color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.qrmBarVal { font-family: var(--font-num); color: var(--ink-soft); flex-shrink: 0; }
.qrmBarTrack { background: var(--paper-alt); border-radius: 4px; height: 8px; overflow: hidden; }
.qrmBarFill { background: var(--action); height: 100%; border-radius: 4px; min-width: 2px; }
.qrmLink { color: var(--action); text-decoration: none; }
.qrmLink:hover { text-decoration: underline; }

/* Bucket sin resolver: fuera del ranking y visualmente aparte, con regla arriba. */
.qrmUnresolved { display: flex; justify-content: space-between; gap: 10px; font-size: 12px; color: var(--ink-soft); padding-top: 8px; margin-top: 4px; border-top: 1px dashed var(--rule); }
.qrmUnresolvedVal { font-family: var(--font-num); flex-shrink: 0; }

.qrmStale { list-style: none; margin: 0; padding: 0; }
.qrmStale li { display: flex; justify-content: space-between; gap: 10px; font-size: 12px; padding: 7px 0; border-bottom: 1px solid var(--rule); }
.qrmStale li:last-child { border-bottom: none; }
.qrmStaleWhen { color: var(--warn-text); flex-shrink: 0; font-size: 11px; }

.qrmEmpty { background: var(--paper); border: 1px dashed var(--steel); border-radius: var(--radius); padding: 40px 20px; text-align: center; }
.qrmEmptyText { color: var(--ink-faint); font-size: 13px; margin: 0; max-width: 520px; margin-left: auto; margin-right: auto; line-height: 1.5; }
.qrmEmptyLink { display: inline-block; margin-top: 10px; font-size: 13px; }
.qrmActions { margin-top: 16px; }
.qrmBtn.btn { background: var(--paper) !important; border-color: var(--steel) !important; color: var(--vr-navy) !important; border-radius: var(--radius-sm) !important; }

/* Solo para lectores de pantalla. Recorte en vez de display:none a propósito: `display:none`
   saca el elemento del árbol de accesibilidad y entonces tampoco existe para el lector. */
.qrmSrOnly {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
}

/* Foco visible: sin esto no se ve dónde está el teclado. El outline va por fuera del
   elemento para no empujar el layout de la barra de navegación. */
.qrmWrap a:focus-visible,
.qrmWrap button:focus-visible,
.qrmWrap .btn:focus-visible,
.qrmWrap .qrNav a:focus-visible {
    outline: 2px solid var(--action);
    outline-offset: 2px;
}

/* Foco en las zonas sensibles del gráfico. El outline de un elemento SVG se dibuja en el
   espacio del viewBox y este va con preserveAspectRatio="none", así que el grosor sale
   deformado: por eso además se tiñe la banda entera, que es lo que de verdad se distingue. */
.qrmHit:focus-visible {
    fill: rgba(30, 91, 135, .14);
    outline: 2px solid var(--action);
    outline-offset: -2px;
}

@media (max-width: 900px) {
    .qrmKpis { grid-template-columns: repeat(2, 1fr); }
    .qrmGrid2 { grid-template-columns: 1fr; }
}
@media (max-width: 720px) {
    .qrmPage { margin: 0; padding: 16px 12px 24px; }
    .qrmHead { flex-direction: column; }
    .qrmRange { width: 100%; }
    .qrmCodeFilters { grid-template-columns: 1fr; }
    .qrmRowTrack { display: none; }
    .qrmFocusBtn { margin-left: 0; }
}
</style>

<script setup lang="ts">
    import { computed, ref, h, watch, nextTick, FunctionalComponent } from "vue";
    import Panel from "@Obsidian/Controls/panel.obs";
    import DropDownList from "@Obsidian/Controls/dropDownList.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import TextBox from "@Obsidian/Controls/textBox.obs";
    import CheckBox from "@Obsidian/Controls/checkBox.obs";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { MetricsData, MetricsOptions, TopCode, UNRESOLVED_COUNTRY_NAME } from "./QrMetrics/types.partial";
    import { truncationNote } from "./QrShared/types.partial";

    const config = useConfigurationValues<{ notAuthorized: boolean; options: MetricsOptions; data: MetricsData }>();
    const invokeBlockAction = useInvokeBlockAction();

    // #region Values

    const notAuthorized = ref(config.notAuthorized === true);
    const options = ref<MetricsOptions>(config.options ?? ({} as MetricsOptions));
    const data = ref<MetricsData>(config.data ?? ({ timeline: [], topCodes: [], staleList: [], byClientType: [], byOperatingSystem: [], byCountry: [], byCity: [] } as unknown as MetricsData));
    const errorMessage = ref("");
    const hoverDay = ref<number | null>(null);
    const rangeDaysRaw = ref("90");
    const codeKeyRaw = ref(options.value.initialCodeKey ?? "");
    let lastRequestId = 0;

    /** Valor del filtro de categoría para los códigos sin categoría. */
    const NO_CATEGORY = "__none__";

    /** 20 filas: se leen sin scroll y 200 códigos son 10 páginas, no una lista infinita. */
    const PAGE_SIZE = 20;

    const codeSearch = ref("");
    const codeCategory = ref("");
    const codeSort = ref("scans");
    const codeShowInactive = ref(false);
    const codePage = ref(0);
    const codeSearchWrap = ref<HTMLElement | null>(null);

    const TL_W = 600;
    const TL_H = 140;

    // Los mismos rangos que Reportería: dos pantallas del mismo módulo con rangos distintos
    // hacen que los números no se puedan comparar entre sí.
    // "Toda la historia" se quitó a propósito: dispara la resolución de geolocalización sobre
    // todos los escaneos históricos.
    const rangeItems: ListItemBag[] = [
        { value: "30", text: "Últimos 30 días" },
        { value: "90", text: "Últimos 90 días" },
        { value: "180", text: "Últimos 6 meses" },
        { value: "365", text: "Último año" }
    ];

    // #endregion

    // #region Computed

    const rangeDays = computed({
        get: () => rangeDaysRaw.value,
        set: (v: string) => { rangeDaysRaw.value = v; void onRangeChange(); }
    });

    // #region Tabla de códigos

    const allCodes = computed<TopCode[]>(() => data.value.allCodes ?? []);

    /** Categorías presentes en los códigos, para el filtro. Sin categoría va al final. */
    const categoryItems = computed<ListItemBag[]>(() => {
        const names = new Set<string>();
        let hasNone = false;
        for (const c of allCodes.value) {
            if (c.categoryName) { names.add(c.categoryName); }
            else { hasNone = true; }
        }
        const items: ListItemBag[] = [...names].sort((a, b) => a.localeCompare(b, "es")).map(n => ({ value: n, text: n }));
        if (hasNone) { items.push({ value: NO_CATEGORY, text: "Sin categoría" }); }
        return items;
    });

    const codeSortItems: ListItemBag[] = [
        { value: "scans", text: "Más escaneados" },
        { value: "recent", text: "Escaneo más reciente" },
        { value: "name", text: "Nombre" }
    ];

    const filteredCodes = computed<TopCode[]>(() => {
        const term = normalize(codeSearch.value.trim());
        const cat = codeCategory.value;

        const list = allCodes.value.filter(c => {
            if (!codeShowInactive.value && !c.isActive && c.idKey !== selected.value?.idKey) { return false; }
            if (cat === NO_CATEGORY ? !!c.categoryName : (cat && c.categoryName !== cat)) { return false; }
            if (term && !normalize(`${c.name ?? ""} ${c.categoryName ?? ""}`).includes(term)) { return false; }
            return true;
        });

        switch (codeSort.value) {
            case "name":
                list.sort((a, b) => (a.name ?? "").localeCompare(b.name ?? "", "es"));
                break;
            case "recent":
                list.sort((a, b) => timeOf(b.lastScanDateTime) - timeOf(a.lastScanDateTime));
                break;
            default:
                list.sort((a, b) => b.count - a.count || (a.name ?? "").localeCompare(b.name ?? "", "es"));
                break;
        }

        return list;
    });

    const pageCount = computed(() => Math.max(1, Math.ceil(filteredCodes.value.length / PAGE_SIZE)));

    const pagedCodes = computed(() =>
        filteredCodes.value.slice(codePage.value * PAGE_SIZE, (codePage.value + 1) * PAGE_SIZE));

    const pageRangeText = computed(() => {
        const total = filteredCodes.value.length;
        const from = codePage.value * PAGE_SIZE + 1;
        const to = Math.min(total, from + PAGE_SIZE - 1);
        return `${fmt(from)}–${fmt(to)} de ${fmt(total)}`;
    });

    const codesCaption = computed(() =>
        `Códigos dinámicos: ${filteredCodes.value.length} de ${allCodes.value.length}, página ${codePage.value + 1} de ${pageCount.value}.`);

    /** Máximo de todo el catálogo: la barra compara contra todos, no contra la página. */
    const codesMax = computed(() => Math.max(1, ...allCodes.value.map(c => c.count)));

    // Cambiar la búsqueda o el orden con la página 7 abierta dejaría una página vacía.
    watch([codeSearch, codeCategory, codeSort, codeShowInactive], () => { codePage.value = 0; });

    // #endregion

    /** El código filtrado según el servidor: manda lo que volvió, no lo que se pidió. */
    const selected = computed<TopCode | null>(() => data.value.selectedCode ?? null);

    const selectedStatus = computed(() => {
        const s = selected.value;
        if (!s) { return ""; }
        if (!s.isActive) { return "Inactivo"; }
        return s.isStale ? "Dormido" : "Activo";
    });

    const timeline = computed(() => data.value.timeline ?? []);
    const timelineMax = computed(() => Math.max(1, ...timeline.value.map(p => p.count)));

    const tlStep = computed(() => timeline.value.length > 1 ? TL_W / (timeline.value.length - 1) : TL_W);

    /**
     * Cómo dibujar la serie. Con un solo día la polilínea no tiene segmento que trazar y el
     * gráfico queda en blanco; con menos de cinco, una línea insinúa una tendencia que no hay.
     */
    const tlMode = computed<"point" | "bars" | "line">(() => {
        const n = timeline.value.length;
        if (n === 1) { return "point"; }
        return n < 5 ? "bars" : "line";
    });

    /** Ancho de la banda de cada día: la usan las barras y las zonas de hover. */
    const tlBandW = computed(() => TL_W / Math.max(1, timeline.value.length));

    const hitW = computed(() => tlMode.value === "line" ? tlStep.value : tlBandW.value);

    const timelinePoints = computed(() =>
        timeline.value.map((p, i) => `${tlX(i)},${tlY(p.count)}`).join(" "));

    const timelineGrid = computed(() => [0, 0.5, 1].map(f => ({ y: TL_H - f * TL_H })));

    const rangeText = computed(() =>
        `Últimos ${rangeDaysRaw.value} días · ${fmt(data.value.totalScans)} escaneos`);

    /** Sin un solo código dinámico no hay nada que medir: el rango no tiene la culpa. */
    const hasDynamicCodes = computed(() => (data.value.dynamicCodeCount ?? 0) > 0);

    /** El detalle con ((Key))=0 es la pantalla de código nuevo, igual que en el catálogo. */
    const newCodeUrl = computed(() => options.value.detailPageUrl
        ? options.value.detailPageUrl.replace("((Key))", "0")
        : (options.value.catalogPageUrl ?? ""));

    const identifiedPct = computed(() => {
        if (!data.value.totalScans) { return 0; }
        return Math.round((data.value.identifiedScans / data.value.totalScans) * 100);
    });

    /**
     * El desglose de países puede traer un bucket que no es un país: los escaneos cuya IP quedó
     * fuera de la muestra que se resuelve contra MaxMind. Se separa del ranking, pero no se
     * descarta: si se descartara, la suma dejaría de cuadrar con el total de escaneos.
     */
    const unresolvedGeo = computed(() =>
        (data.value.byCountry ?? []).find(c => !c.countryCode && c.countryName === UNRESOLVED_COUNTRY_NAME) ?? null);

    const rankedCountries = computed(() =>
        (data.value.byCountry ?? []).filter(c => c !== unresolvedGeo.value));

    const topCountryName = computed(() => rankedCountries.value[0]?.countryName ?? "");

    const isWeekly = computed(() => data.value.timelineIsWeekly === true);

    const timelineTitle = computed(() => isWeekly.value ? "Escaneos por semana" : "Escaneos por día");

    /**
     * El punto más alto de la serie. No se deriva de `timelineMax`, que arranca en Math.max(1, …)
     * para no dividir por cero: con la serie entera en cero ese 1 no es el dato de nadie.
     */
    const peakPoint = computed(() => {
        let best = timeline.value[0] ?? null;
        for (const p of timeline.value) { if (best === null || p.count > best.count) { best = p; } }
        return best;
    });

    const timelineTotal = computed(() => timeline.value.reduce((sum, p) => sum + p.count, 0));

    /** Lo que el lector de pantalla escucha en lugar del dibujo: rango, total y pico. */
    const timelineSummary = computed(() => {
        const points = timeline.value;
        if (!points.length) { return "Serie de escaneos sin datos."; }

        const unit = isWeekly.value ? "semanas" : "días";
        const desde = longDate(points[0].date);
        const hasta = longDate(points[points.length - 1].date);
        const peak = peakPoint.value;
        const cuando = isWeekly.value ? "la semana del" : "el";

        return `${timelineTitle.value}. ${points.length} ${unit}, del ${desde} al ${hasta}. `
            + `Total ${fmt(timelineTotal.value)} escaneos. `
            + `Máximo ${fmt(peak?.count ?? 0)} en ${cuando} ${longDate(peak?.date)}.`;
    });

    type BarRow = { key: string; name: string; count: number; pct: number; row?: TopCode };

    function toBars(items: { name: string; count: number; key?: string; row?: TopCode }[]): BarRow[] {
        const max = Math.max(1, ...items.map(i => i.count));
        return items.map((i, idx) => ({
            key: i.key ?? `${i.name}-${idx}`,
            name: i.name,
            count: i.count,
            pct: (i.count / max) * 100,
            row: i.row
        }));
    }

    const topRows = computed(() => toBars(
        (data.value.topCodes ?? []).map(c => ({ name: c.name ?? "(sin nombre)", count: c.count, key: c.idKey ?? c.name ?? "", row: c }))));

    const clientRows = computed(() => toBars((data.value.byClientType ?? []).map(c => ({ name: c.name, count: c.count }))));
    const osRows = computed(() => toBars((data.value.byOperatingSystem ?? []).map(c => ({ name: c.name, count: c.count }))));
    const countryRows = computed(() => toBars(rankedCountries.value.map(c => ({ name: c.countryName ?? "Desconocido", count: c.count }))));
    const cityRows = computed(() => toBars((data.value.byCity ?? []).map(c => ({ name: c.city ?? "—", count: c.count }))));

    // #endregion

    // #region Functions

    function tlX(i: number): number {
        return timeline.value.length > 1 ? (i / (timeline.value.length - 1)) * TL_W : TL_W / 2;
    }

    function tlY(count: number): number {
        return TL_H - (count / timelineMax.value) * TL_H;
    }

    /** Borde izquierdo de la banda del día i. */
    function tlBandX(i: number): number {
        return tlBandW.value * i;
    }

    /** En modo línea la zona sensible se centra en la marca; en barras, en la banda. */
    function hitX(i: number): number {
        return tlMode.value === "line" ? tlX(i) - tlStep.value / 2 : tlBandX(i);
    }

    function fmt(n: number | null | undefined): string {
        return (n ?? 0).toLocaleString("es-GT");
    }

    function shortDate(value: string | null | undefined): string {
        if (!value) { return ""; }
        try { return new Date(value).toLocaleDateString("es-GT", { month: "short", day: "numeric" }); }
        catch { return value; }
    }

    function longDate(value: string | null | undefined): string {
        if (!value) { return ""; }
        try { return new Date(value).toLocaleDateString("es-GT", { year: "numeric", month: "long", day: "numeric" }); }
        catch { return value; }
    }

    /** Nombre accesible de cada zona sensible: es lo que se oye al tabular por la serie. */
    function pointLabel(i: number): string {
        const p = timeline.value[i];
        if (!p) { return ""; }

        const cuando = isWeekly.value ? `semana del ${longDate(p.date)}` : longDate(p.date);
        return `${cuando}: ${fmt(p.count)} escaneos`;
    }

    function hrefFor(row: TopCode | undefined): string {
        if (!row || !options.value.detailPageUrl) { return ""; }
        return options.value.detailPageUrl.replace("((Key))", row.idKey ?? "");
    }

    type BarListProps = { rows: BarRow[]; onPick?: (row: TopCode) => void };

    /**
     * Lista de barras horizontales. Una sola serie de magnitud: un tono, y el nombre de cada fila
     * lleva la identidad — por eso no hace falta leyenda ni paleta categórica.
     */
    // Las listas van recortadas en el servidor. Declararlo es la diferencia entre "estos son
    // los países" y "estos son los 8 primeros de 20": sin la línea, la primera barra llega al
    // 100 % y se lee como el total.
    const topNote = computed(() => truncationNote(data.value.topCodesMeta, "escaneos"));
    const osNote = computed(() => truncationNote(data.value.byOperatingSystemMeta, "escaneos"));
    const countryNote = computed(() => truncationNote(data.value.byCountryMeta, "escaneos"));
    const cityNote = computed(() => truncationNote(data.value.byCityMeta, "escaneos del país"));

    const BarList: FunctionalComponent<BarListProps> = (props) => {
        if (!props.rows.length) {
            return h("div", { class: "qrmNone" }, "Sin datos en este rango.");
        }

        return h("ul", { class: "qrmBars" }, props.rows.map(r => {
            // Con onPick el nombre es un botón que filtra el panel: el top es la forma más
            // directa de llegar a los códigos que importan.
            const row = r.row;
            const label = props.onPick && row
                ? h("button", {
                    type: "button",
                    class: "qrmBarName qrmBarPick",
                    title: `Ver solo ${r.name}`,
                    onClick: () => props.onPick?.(row)
                }, r.name)
                : h("span", { class: "qrmBarName", title: r.name }, r.name);

            return h("li", { class: "qrmBar", key: r.key }, [
                // El nombre y el valor van juntos en la misma línea: el lector lee "Android 1.204"
                // sin que haga falta ningún aria, porque el valor ya está visible al lado.
                h("div", { class: "qrmBarTop" }, [label, h("span", { class: "qrmBarVal" }, fmt(r.count))]),
                // La barra es puro decorado del número de arriba: sin aria-hidden el lector anuncia
                // dos contenedores vacíos por fila.
                h("div", { class: "qrmBarTrack", "aria-hidden": "true" }, [
                    h("div", { class: "qrmBarFill", style: { width: `${Math.max(1, r.pct)}%` } })
                ])
            ]);
        }));
    };

    // Sin esto Vue trata cada atributo como attr crudo (instance.props = attrs) y los attrs NO se
    // camelizan: `href-for` nunca llegaba a `props.hrefFor` y el top perdía los enlaces en silencio.
    BarList.props = ["rows", "onPick"];

    // #endregion

    // #region Event Handlers

    /** Filtra el panel por un código ("" = todos) y sube a ver el resultado. */
    function selectCode(key: string): void {
        if (key === codeKeyRaw.value) { return; }
        codeKeyRaw.value = key;
        void onRangeChange();
        window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function pickRow(row: TopCode): void {
        if (row.idKey) { selectCode(row.idKey); }
    }

    /** Baja a la tabla y deja el cursor en el buscador. */
    function goToCodes(): void {
        document.getElementById("qrmCodes")?.scrollIntoView({ behavior: "smooth", block: "start" });
        void nextTick(() => codeSearchWrap.value?.querySelector("input")?.focus({ preventScroll: true }));
    }

    function normalize(value: string): string {
        return value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
    }

    function timeOf(value: string | null | undefined): number {
        if (!value) { return 0; }
        const t = new Date(value).getTime();
        return isNaN(t) ? 0 : t;
    }

    function rowPct(row: TopCode): number {
        return row.count > 0 ? Math.max(2, Math.round((row.count / codesMax.value) * 100)) : 0;
    }

    async function onRangeChange(): Promise<void> {
        errorMessage.value = "";
        hoverDay.value = null;

        const requestId = ++lastRequestId;
        const result = await invokeBlockAction<MetricsData>("Refresh", {
            days: Number(rangeDaysRaw.value),
            qrCodeKey: codeKeyRaw.value
        });

        // Si mientras tanto se cambió el código o el rango, esta respuesta ya no es la que se ve.
        if (requestId !== lastRequestId) {
            return;
        }

        if (!result.isSuccess || !result.data) {
            errorMessage.value = result.errorMessage || "No se pudieron cargar las métricas.";
            return;
        }

        data.value = result.data;
        syncUrl();
    }

    /**
     * Deja el código en la URL (QrCodeId) para que el enlace se pueda compartir o recargar sin
     * perder el filtro. replaceState: cambiar el filtro no debe llenar el historial.
     */
    function syncUrl(): void {
        try {
            const url = new URL(window.location.href);
            if (codeKeyRaw.value) {
                url.searchParams.set("QrCodeId", codeKeyRaw.value);
            }
            else {
                url.searchParams.delete("QrCodeId");
            }
            window.history.replaceState(window.history.state, "", url.toString());
        }
        catch {
            // Sin URL sincronizada el panel funciona igual.
        }
    }

    /**
     * Celda CSV segura. Excel ejecuta como fórmula cualquier celda que empiece con = + - o @,
     * y los nombres de los códigos los escribe el usuario: un "=HYPERLINK(...)" se ejecutaría
     * al abrir el archivo. El apóstrofo inicial la fuerza a texto.
     */
    function csvCell(value: string | null | undefined): string {
        const raw = String(value ?? "");
        const safe = /^[=+\-@]/.test(raw) ? `'${raw}` : raw;
        return `"${safe.replace(/"/g, "\"\"")}"`;
    }

    /** Exporta lo que está en pantalla. Solo agregados: nunca IPs ni personas. */
    function onExport(): void {
        const lines: string[] = ["seccion,etiqueta,escaneos"];

        const push = (section: string, rows: { name: string; count: number }[]): void => {
            for (const r of rows) {
                lines.push(`${section},${csvCell(r.name)},${r.count}`);
            }
        };

        if (!selected.value) {
            push("top", topRows.value);
        }
        push("dispositivo", clientRows.value);
        push("sistema_operativo", osRows.value);
        push("pais", countryRows.value);

        // El bucket sin resolver va en su propia sección: mezclarlo con los países haría que la
        // columna "pais" tenga una fila que no es un país, y sacarlo haría que no cuadre el total.
        if (unresolvedGeo.value) {
            lines.push(`pais_no_resuelto,${csvCell(unresolvedGeo.value.countryName)},${unresolvedGeo.value.count}`);
        }

        push("ciudad", cityRows.value);

        const timelineSection = isWeekly.value ? "semana" : "dia";
        for (const p of timeline.value) {
            lines.push(`${timelineSection},${csvCell(p.date.substring(0, 10))},${p.count}`);
        }

        // BOM para que Excel en español abra bien los acentos.
        const blob = new Blob(["﻿" + lines.join("\r\n")], { type: "text/csv;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const anchor = document.createElement("a");
        anchor.href = url;
        const slug = selected.value?.name
            ? "-" + selected.value.name.normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/[^a-zA-Z0-9]+/g, "-").replace(/^-|-$/g, "").toLowerCase()
            : "";
        anchor.download = `qr-metricas${slug}-${new Date().toISOString().substring(0, 10)}.csv`;
        anchor.style.display = "none";
        document.body.appendChild(anchor);
        anchor.click();
        document.body.removeChild(anchor);
        setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    // #endregion
</script>
