<template>
    <Panel type="block" title="Cupos Servicios Dominicales" :hasNoBodyPadding="true">
        <template #default>
            <div class="caPage">
                <div class="caTopBar">
                    <div class="caBrand">Disponibilidad · Servicios Dominicales</div>
                    <!-- Segmentado propio: TabbedBar de Rock mide su ancho para decidir qué
                         pestañas caben y, dentro de un flex que se encoge al contenido, concluía
                         que no cabía ninguna y escondía «Métricas» bajo un menú «More». -->
                    <div class="caSeg" role="tablist" aria-label="Vista">
                        <button v-for="t in tabs"
                                :key="t"
                                type="button"
                                role="tab"
                                class="caSegBtn"
                                :class="{ isActive: activeTab === t }"
                                :aria-selected="activeTab === t"
                                @click="activeTab = t">{{ t }}</button>
                    </div>
                </div>

                <div class="caContainer">
                    <NotificationBox v-if="config.notAuthorized" alertType="warning">
                        No tienes permiso para administrar la disponibilidad.
                    </NotificationBox>

                    <NotificationBox v-else-if="config.configError" alertType="warning">
                        {{ config.configError }}
                    </NotificationBox>

                    <div v-else>
                        <!-- ===== Zona 1: Contexto ===== -->
                        <div class="caCard caContext">
                            <div class="caField">
                                <label class="caLabel">Sede</label>
                                <select v-model.number="campusId" class="caSelect">
                                    <option :value="0" disabled>Selecciona sede…</option>
                                    <option v-for="c in config.campuses" :key="c.value" :value="c.value">{{ c.text }}</option>
                                </select>
                            </div>

                            <div v-if="activeTab !== 'Servicios especiales'" class="caField">
                                <label class="caLabel">Desde</label>
                                <input type="date" v-model="rangeStart" class="caInput" />
                            </div>

                            <div v-if="activeTab !== 'Servicios especiales'" class="caField">
                                <label class="caLabel">Hasta</label>
                                <input type="date" v-model="rangeEnd" class="caInput" />
                            </div>

                            <div v-if="activeTab === 'Métricas'" class="caPresets">
                                <button type="button" class="caChip" @click="applyWeekPreset(0)">Esta semana</button>
                                <button type="button" class="caChip" @click="applyWeekPreset(-1)">Semana pasada</button>
                                <button type="button" class="caChip" @click="applyPastPreset(4)">Últimas 4 sem.</button>
                                <button type="button" class="caChip" @click="applyPastPreset(12)">Últimas 12</button>
                                <button type="button" class="caChip" @click="applyPastPreset(26)">Últimas 26</button>
                            </div>
                            <div v-else-if="activeTab !== 'Servicios especiales'" class="caPresets">
                                <button type="button" class="caChip" @click="applyConfigWeekPreset(0)">Esta semana</button>
                                <button type="button" class="caChip" @click="applyConfigWeekPreset(-1)">Semana pasada</button>
                                <button type="button" class="caChip" @click="applyPreset(28)">4 semanas</button>
                                <button type="button" class="caChip" @click="applyPreset(91)">3 meses</button>
                                <button type="button" class="caChip" @click="applyPreset(182)">6 meses</button>
                            </div>
                        </div>

                        <div v-if="!campusId" class="caEmpty">
                            Selecciona una sede para ver y administrar su disponibilidad.
                        </div>

                        <!-- ===== Pestaña: Métricas ===== -->
                        <template v-else-if="activeTab === 'Métricas'">
                            <div v-if="metricsBusy && metricsWeeks.length === 0" class="caMuted caSmall caEmpty">Cargando…</div>
                            <div v-else-if="metricsError" class="caGenResult">
                                <NotificationBox alertType="danger">{{ metricsError }}</NotificationBox>
                            </div>
                            <div v-else-if="metricsWeeks.length === 0" class="caEmpty">
                                No hay servicios en este rango.
                                <div class="caEmptyAction caPresets">
                                    <button type="button" class="caChip" @click="applyWeekPreset(-1)">Ver semana pasada</button>
                                    <button type="button" class="caChip" @click="applyPastPreset(12)">Ver últimas 12 semanas</button>
                                </div>
                            </div>

                            <template v-else>
                                <!-- Semana seleccionada: KPIs -->
                                <div class="caCard">
                                    <div class="caMetricsHead">
                                        <div>
                                            <div class="caCardTitle">Semana del {{ selectedWeek?.label ?? "—" }}</div>
                                            <div class="caCardSub">
                                                <template v-if="selectedWeek?.isPast">Servicio ya realizado: la diferencia entre reservados e ingresados son los que no vinieron.</template>
                                                <template v-else>Servicio pendiente o en curso: todavía pueden ingresar.</template>
                                            </div>
                                        </div>
                                        <label class="caWeekPick">
                                            <span class="caLabel">Semana</span>
                                            <select v-model="selectedWeekKey" class="caSelect caSelectSm">
                                                <option v-for="w in metricsWeeks" :key="w.weekStart" :value="w.weekStart">{{ w.label }}</option>
                                            </select>
                                        </label>
                                    </div>

                                    <div v-if="selectedWeek" class="caKpis">
                                        <div class="caKpi">
                                            <div class="caKpiValue">{{ selectedWeek.reserved }}</div>
                                            <div class="caKpiLabel">Reservados <span class="caKpiSub">de {{ selectedWeek.capacity }} cupos</span></div>
                                        </div>
                                        <div class="caKpi">
                                            <div class="caKpiValue"><span class="caSwatch" :style="{ background: SERIES.checkedIn.color }"></span>{{ selectedWeek.checkedIn }}</div>
                                            <div class="caKpiLabel">Ingresaron <span class="caKpiSub">{{ pct(selectedWeek.checkedIn, selectedWeek.reserved) }}</span></div>
                                        </div>
                                        <div v-if="selectedWeek.isPast" class="caKpi">
                                            <div class="caKpiValue"><span class="caSwatch" :style="{ background: SERIES.noShow.color }"></span>{{ selectedWeek.noShow }}</div>
                                            <div class="caKpiLabel">No vinieron <span class="caKpiSub">{{ pct(selectedWeek.noShow, selectedWeek.reserved) }}</span></div>
                                        </div>
                                        <div v-else class="caKpi">
                                            <div class="caKpiValue"><span class="caSwatch" :style="{ background: SERIES.pending.color }"></span>{{ selectedWeek.pending }}</div>
                                            <div class="caKpiLabel">Pendientes <span class="caKpiSub">{{ pct(selectedWeek.pending, selectedWeek.reserved) }}</span></div>
                                        </div>
                                        <div class="caKpi">
                                            <div class="caKpiValue">{{ pct(selectedWeek.reserved, selectedWeek.capacity, true) }}</div>
                                            <div class="caKpiLabel">Ocupación <span class="caKpiSub">reservados sobre cupos</span></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Por horario, semana seleccionada -->
                                <div class="caCard">
                                    <div class="caCardTitle">Por horario · {{ selectedWeek?.label ?? "" }}</div>
                                    <div class="caCardSub">Personas por servicio. La altura total de cada barra son los reservados.</div>
                                    <div class="caChartWrap caChartWrapShort">
                                        <canvas ref="scheduleChartCanvas" role="img" aria-label="Barras apiladas por horario: ingresaron, no vinieron y pendientes"></canvas>
                                    </div>
                                </div>

                                <!-- Por semana -->
                                <div class="caCard">
                                    <div class="caCardTitle">Por semana</div>
                                    <div class="caCardSub">Todos los horarios sumados. Toca una barra para ver esa semana arriba.</div>
                                    <div class="caChartWrap">
                                        <canvas ref="weekChartCanvas" role="img" aria-label="Barras apiladas por semana: ingresaron, no vinieron y pendientes"></canvas>
                                    </div>
                                </div>

                                <!-- Tabla (vista accesible y respaldo de las etiquetas) -->
                                <div class="caCard" v-if="selectedWeek">
                                    <div class="caCardTitle">Detalle · {{ selectedWeek.label }}</div>
                                    <div class="caTableWrap">
                                        <table class="caTable">
                                            <thead>
                                                <tr>
                                                    <th>Horario</th>
                                                    <th class="num">Cupos</th>
                                                    <th class="num">Reservados</th>
                                                    <th class="num">Ingresaron</th>
                                                    <th class="num">{{ selectedWeek.isPast ? "No vinieron" : "Pendientes" }}</th>
                                                    <th class="num">Asistencia</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr v-for="m in selectedWeek.schedules" :key="m.scheduleId">
                                                    <td>{{ m.scheduleName }}</td>
                                                    <td class="num">{{ m.capacity }}</td>
                                                    <td class="num">{{ m.reserved }}</td>
                                                    <td class="num">{{ m.checkedIn }}</td>
                                                    <td class="num">{{ m.isPast ? m.noShow : m.pending }}</td>
                                                    <td class="num">{{ pct(m.checkedIn, m.reserved) }}</td>
                                                </tr>
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <td>Total</td>
                                                    <td class="num">{{ selectedWeek.capacity }}</td>
                                                    <td class="num">{{ selectedWeek.reserved }}</td>
                                                    <td class="num">{{ selectedWeek.checkedIn }}</td>
                                                    <td class="num">{{ selectedWeek.isPast ? selectedWeek.noShow : selectedWeek.pending }}</td>
                                                    <td class="num">{{ pct(selectedWeek.checkedIn, selectedWeek.reserved) }}</td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                            </template>
                        </template>

                        <!-- ===== Pestaña: Servicios especiales ===== -->
                        <template v-else-if="activeTab === 'Servicios especiales'">
                            <div class="caCard">
                                <div class="caSpHead">
                                    <div>
                                        <div class="caCardTitle">Servicios especiales</div>
                                        <div class="caCardSub">
                                            Para Nochebuena, Año Nuevo o un domingo con otro horario. La gente reserva en la app
                                            y la puerta los lee igual que un domingo normal.
                                        </div>
                                    </div>
                                    <RockButton v-if="!formOpen" btnType="primary" @click="openForm">+ Nuevo servicio especial</RockButton>
                                </div>

                                <NotificationBox v-if="!config.doorColumnReady" alertType="info" class="caPlannerNote">
                                    Por ahora todos los servicios se muestran en la app y la puerta abre 15 min antes y cierra 1 h 20 min después del inicio.
                                    Para poder cambiar eso, TI debe preparar la base de datos (script QREVENT_SundayService_SlotSettings.sql).
                                </NotificationBox>

                                <NotificationBox v-if="createdResult" :alertType="createdResult.kind" class="caGenResult">
                                    <div class="notranslate">{{ createdResult.title }}</div>
                                    <ul v-if="createdResult.lines.length" class="caWarnList">
                                        <li v-for="(l, i) in createdResult.lines" :key="i" class="notranslate">{{ l }}</li>
                                    </ul>
                                </NotificationBox>

                                <!-- Formulario guiado -->
                                <div v-if="formOpen" class="caSpForm">
                                    <div class="caSpFormTitle">Nuevo servicio especial</div>

                                    <div class="caSpSection">
                                        <div class="caSpQ"><span class="caStepNum">1</span> ¿Cuándo es?</div>
                                        <div class="caSpFields">
                                            <div class="caField">
                                                <label class="caLabel">Fecha</label>
                                                <input type="date" v-model="fDate" :min="todayIso" class="caInput" />
                                            </div>
                                            <div class="caField">
                                                <label class="caLabel">Hora de inicio</label>
                                                <input type="time" v-model="fTime" step="300" class="caInput" />
                                            </div>
                                        </div>
                                        <div v-if="fDateLong" class="caSpHint notranslate">{{ fDateLong }}</div>
                                    </div>

                                    <div class="caSpSection">
                                        <div class="caSpQ"><span class="caStepNum">2</span> ¿Cómo se llama y cuántos lugares hay?</div>
                                        <div class="caSpFields">
                                            <div class="caField caFieldWide">
                                                <label class="caLabel">Nombre <span class="caMuted">(opcional)</span></label>
                                                <input type="text" v-model="fName" maxlength="40" placeholder="Ej.: Nochebuena" class="caInput" />
                                            </div>
                                            <div class="caField">
                                                <label class="caLabel">Lugares</label>
                                                <input type="number" min="1" step="1" v-model.number="fCap" class="caInput" />
                                            </div>
                                        </div>
                                        <div class="caSpHint">
                                            La hora se agrega sola al nombre. Así se verá: <b class="notranslate">«{{ fFinalName }}»</b>.
                                        </div>
                                    </div>

                                    <div class="caSpSection">
                                        <div class="caSpQ"><span class="caStepNum">3</span> ¿A qué hora abre y cierra la puerta?</div>
                                        <div class="caSpFields">
                                            <div class="caField">
                                                <label class="caLabel">La puerta abre a las</label>
                                                <input type="time" v-model="fOpenTime" step="300" class="caInput" :disabled="fStart === null || !config.doorColumnReady" />
                                            </div>
                                            <div class="caField">
                                                <label class="caLabel">La puerta cierra a las</label>
                                                <input type="time" v-model="fCloseTime" step="300" class="caInput" :disabled="fStart === null || !config.doorColumnReady" />
                                            </div>
                                        </div>
                                        <div class="caSpHint">
                                            <template v-if="fStart === null">Primero pon la hora de inicio.</template>
                                            <template v-else>
                                                Ya vienen con lo normal: 15 min antes y 1 h 20 min después del inicio. Cámbialas si este servicio lo necesita.
                                                La app deja de aceptar reservas a la misma hora en que cierra la puerta.
                                                <button v-if="fDoorIsCustom" type="button" class="caLinkBtn" @click="resetFormDoor">Volver a lo normal</button>
                                            </template>
                                        </div>
                                        <div v-if="fDoorError" class="caSpError notranslate">{{ fDoorError }}</div>
                                    </div>

                                    <div class="caSpSection">
                                        <div class="caSpQ"><span class="caStepNum">4</span> ¿Se muestra en la página de reservas?</div>
                                        <label class="caCheck">
                                            <input type="checkbox" v-model="fShow" :disabled="!config.doorColumnReady" />
                                            <span>Mostrar en la app de reservas <span class="caMuted">(la gente lo ve y puede reservar)</span></span>
                                        </label>
                                        <div v-if="!fShow" class="caSpHint">
                                            No aparecerá en la página de reservas, pero la puerta lo leerá igual. Puedes mostrarlo después con «Editar».
                                        </div>
                                    </div>

                                    <!-- Solo se pregunta por los servicios ACTIVOS de ese día. Los desactivados se muestran
                                         como información y el formulario nunca los reactiva (2026-11-23: ofrecer «Se mantiene»
                                         en uno desactivado lo reactivaba sin querer). -->
                                    <div v-if="fActiveDaySlots.length > 0 || fInactiveDayNames.length > 0" class="caSpSection">
                                        <div class="caSpQ"><span class="caStepNum">5</span> Ese día ya hay otros servicios. ¿Siguen ese día?</div>
                                        <div v-for="s in fActiveDaySlots" :key="s.slotId" class="caKeepRow">
                                            <div class="caKeepMain">
                                                <span class="notranslate caKeepName">{{ s.scheduleName }}</span>
                                                <span v-if="s.isSpecial" class="caBadge caBadgeSpecial">Especial</span>
                                                <span class="caMuted caSmall notranslate">· {{ s.reservedCount }} reservados</span>
                                            </div>
                                            <div class="caChoice" role="group">
                                                <button type="button" class="caChoiceBtn" :class="{ isActive: s.keep }" @click="s.keep = true">Sí habrá</button>
                                                <button type="button" class="caChoiceBtn" :class="{ isActive: !s.keep }" :disabled="s.reservedCount + s.holdCount > 0" @click="s.keep = false">No habrá</button>
                                            </div>
                                            <div v-if="s.reservedCount + s.holdCount > 0" class="caKeepNote">
                                                Tiene reservas: no se puede quitar. Puedes ocultarlo de la app con «Editar» en «Semana normal» y avisar a quienes reservaron.
                                            </div>
                                        </div>
                                        <div v-if="fInactiveDayNames.length > 0" class="caSpHint notranslate">
                                            Ya desactivados ese día (no cambian): {{ fInactiveDayNames.join(", ") }}.
                                        </div>
                                    </div>

                                    <div v-if="timelineRows.length > 0" class="caSpSection">
                                        <div class="caSpQ">Así quedará la puerta ese día</div>
                                        <div class="caTimeline">
                                            <div class="caTimelineRow caTimelineAxisRow">
                                                <div class="caTimelineLabel"></div>
                                                <div class="caTimelineTrack caTimelineAxis">
                                                    <span v-for="t in timelineTicks" :key="t.label" class="caTimelineTick notranslate" :style="{ left: t.left + '%' }">{{ t.label }}</span>
                                                </div>
                                                <div class="caTimelineHours"></div>
                                            </div>
                                            <div v-for="r in timelineRows" :key="r.key" class="caTimelineRow" :class="{ isOff: !r.active, isPreview: r.preview }">
                                                <div class="caTimelineLabel notranslate" :title="r.name">{{ r.name }}</div>
                                                <div class="caTimelineTrack">
                                                    <div class="caTimelineBar" :class="{ isSpecial: r.special, isOff: !r.active, isPreview: r.preview }" :style="{ left: r.left + '%', width: r.width + '%' }" :title="r.title">
                                                        <span class="caTimelineStart" :style="{ left: r.startPct + '%' }"></span>
                                                    </div>
                                                </div>
                                                <div class="caTimelineHours notranslate">{{ r.hoursText }}</div>
                                            </div>
                                            <div class="caTimelineLegend">
                                                <span><i class="caLegendBar isPreview"></i> Este servicio especial</span>
                                                <span><i class="caLegendBar"></i> Otros servicios</span>
                                                <span><i class="caLegendBar isOff"></i> No habrá</span>
                                                <span><i class="caLegendStart"></i> Hora de inicio</span>
                                            </div>
                                            <div v-if="hasOverlap" class="caTimelineNote">
                                                Algunas puertas están abiertas al mismo tiempo. No hay problema: el escáner reconoce el servicio de cada reserva.
                                            </div>
                                        </div>
                                    </div>

                                    <div class="caSpSummary">
                                        <div class="caSpSummaryTitle">Resumen</div>
                                        <div v-if="fMissing" class="caSpSummaryMissing notranslate">{{ fMissing }}</div>
                                        <ul v-else>
                                            <li v-for="(l, i) in fSummary" :key="i" class="notranslate">{{ l }}</li>
                                        </ul>
                                        <div class="caSpActions">
                                            <RockButton btnType="primary" @click="createSpecial" :disabled="formBusy || !!fMissing">
                                                <span class="notranslate">{{ formBusy ? "Creando…" : "Crear servicio especial" }}</span>
                                            </RockButton>
                                            <RockButton btnType="link" @click="closeForm" :disabled="formBusy">Cancelar</RockButton>
                                        </div>
                                        <NotificationBox v-if="formError" alertType="warning" class="caGenResult">
                                            <span class="notranslate">{{ formError }}</span>
                                        </NotificationBox>
                                    </div>
                                </div>

                                <!-- Programados -->
                                <div class="caSpListTitle">Programados</div>
                                <div v-if="upcomingBusy && upcomingSpecials.length === 0" class="caMuted caSmall">Cargando…</div>
                                <div v-else-if="upcomingSpecials.length === 0" class="caEmpty caEmptyCompact">
                                    Todavía no hay servicios especiales. Usa «+ Nuevo servicio especial».
                                </div>
                                <div v-for="s in upcomingSpecials" :key="s.slotId" class="caSpCard" :class="{ isInactive: !s.isActive }">
                                    <div class="caSpCardRow">
                                        <div class="caSpCardDate notranslate">{{ s.occurrenceDateText }}</div>
                                        <div class="caSpCardMain">
                                            <div class="caSpCardName">
                                                <span class="notranslate">{{ s.scheduleName }}</span>
                                                <span v-if="!s.isActive" class="caBadge caBadgeOff">Desactivado</span>
                                                <span v-else-if="!s.showInApp" class="caBadge caBadgeHidden">Oculto en la app</span>
                                            </div>
                                            <div class="caMuted caSmall notranslate">
                                                {{ s.reservedCount }} de {{ s.capacity }} reservados<template v-if="s.checkedInCount"> · {{ s.checkedInCount }} ingresaron</template><template v-if="s.timeText"> · Puerta de {{ doorRangeText(s) }}</template>
                                            </div>
                                        </div>
                                        <div class="caSpCardActions">
                                            <button type="button" class="caMiniBtn" :disabled="rowBusy === s.slotId" @click="toggleEditor(s)">
                                                {{ editors[s.slotId] ? "Cerrar" : "Editar" }}
                                            </button>
                                            <button type="button" class="caMiniBtn" :disabled="rowBusy === s.slotId" @click="toggleFromUpcoming(s)">
                                                <span class="notranslate">{{ s.isActive ? "Desactivar" : "Reactivar" }}</span>
                                            </button>
                                        </div>
                                    </div>

                                    <div v-if="editors[s.slotId]" class="caEditor">
                                        <div class="caEditorFields">
                                            <div class="caField">
                                                <label class="caLabel">Lugares</label>
                                                <input type="number" min="0" step="1" v-model.number="editors[s.slotId].capacity" class="caInput" />
                                            </div>
                                            <div class="caField">
                                                <label class="caLabel">La puerta abre a las</label>
                                                <input type="time" step="300" v-model="editors[s.slotId].openTime" class="caInput" :disabled="!config.doorColumnReady || !s.timeText" />
                                            </div>
                                            <div class="caField">
                                                <label class="caLabel">La puerta cierra a las</label>
                                                <input type="time" step="300" v-model="editors[s.slotId].closeTime" class="caInput" :disabled="!config.doorColumnReady || !s.timeText" />
                                            </div>
                                        </div>
                                        <label class="caCheck">
                                            <input type="checkbox" v-model="editors[s.slotId].showInApp" :disabled="!config.doorColumnReady" />
                                            <span>Mostrar en la app de reservas</span>
                                        </label>
                                        <div v-if="editorError(s)" class="caSpError notranslate">{{ editorError(s) }}</div>
                                        <div class="caEditorActions">
                                            <button type="button" class="caMiniBtn caMiniBtnSave" :disabled="rowBusy === s.slotId || !!editorError(s)" @click="saveEditor(s)">Guardar</button>
                                            <button type="button" class="caMiniBtn" :disabled="rowBusy === s.slotId || !config.doorColumnReady || !s.timeText" @click="normalEditor(s)">Puerta normal</button>
                                        </div>
                                    </div>
                                </div>

                                <details class="caHowTo">
                                    <summary>¿Cómo funciona?</summary>
                                    <ul>
                                        <li>La app muestra los servicios de los próximos 7 días: un servicio especial se puede reservar desde 6 días antes.</li>
                                        <li>«Mostrar en la app» decide si la gente lo ve en la página de reservas. Si está oculto, nadie nuevo puede reservar, pero quien ya reservó entra igual con su QR.</li>
                                        <li>La puerta normalmente abre 15 min antes y cierra 1 h 20 min después del inicio. Se puede cambiar en cada servicio (también en los normales, desde «Semana normal» → Editar).</li>
                                        <li>Si alguien llega antes de que abra la puerta, el escáner le dice a qué hora abre su servicio.</li>
                                        <li>Un servicio con reservas no se puede desactivar: hazlo antes de que abra la reserva o avisa primero a quienes reservaron.</li>
                                        <li>Mientras un día tenga un servicio especial, «Aplicar plantilla» no vuelve a activar los servicios normales de ese día.</li>
                                        <li>Para quitar un servicio especial usa «Desactivar». No lo borres desde Horarios de Rock.</li>
                                    </ul>
                                </details>
                            </div>
                        </template>

                        <template v-else>
                            <!-- ===== Zona 2: Plantilla ===== -->
                            <div class="caCard">
                                <div class="caCardTitle">Plantilla de horarios</div>
                                <div class="caCardSub">
                                    Define la capacidad de cada horario y aplícala a todas las fechas del rango de arriba.
                                    La casilla de la izquierda solo elige a qué horarios se aplica la plantilla: <b>no oculta nada</b>.
                                    Para que un horario no salga en la página de reservas, desmarca su «Visible en la app»: <b>se aplica al instante</b>
                                    a sus fechas del rango de arriba (de hoy en adelante). Para una sola fecha usa <b>Editar</b> en la lista de abajo.
                                </div>

                                <div class="caTplHeader">☑ = aplicar la plantilla a este horario</div>

                                <div class="caTplRows">
                                    <div v-for="row in templateRows" :key="row.scheduleId" class="caTplRow" :class="{ isOff: !row.include }">
                                        <label class="caTplToggle">
                                            <input type="checkbox" v-model="row.include" />
                                            <span class="caTplName">{{ row.name }}</span>
                                            <span class="caTplMeta">{{ row.dayText }}<template v-if="row.timeText"> · {{ row.timeText }}</template></span>
                                        </label>

                                        <div class="caTplRight">
                                            <label class="caCheck caCheckSm" title="Se aplica al instante a las fechas de este horario dentro del rango de arriba (de hoy en adelante) y a las que cree la plantilla. Ocultar no apaga la puerta: quien ya reservó entra igual.">
                                                <input type="checkbox"
                                                       :checked="rowVisibility(row).allVisible"
                                                       :indeterminate.prop="rowVisibility(row).mixed"
                                                       :disabled="!config.doorColumnReady || visBusy === row.scheduleId"
                                                       @change="onRowVisibilityChange(row, $event)" />
                                                <span>Visible en la app</span>
                                                <span v-if="rowVisibility(row).hidden > 0" class="caMuted notranslate">({{ rowVisibility(row).hidden }} oculta{{ rowVisibility(row).hidden === 1 ? "" : "s" }})</span>
                                            </label>
                                            <div class="caTplCap">
                                                <span class="caTplCapLabel">Capacidad</span>
                                                <input type="number" min="0" step="1" v-model.number="row.capacity" class="caInput caCapInput" :disabled="!row.include" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <label class="caOption">
                                    <input type="checkbox" v-model="overwriteCapacity" />
                                    <span>Sobrescribir la capacidad de las fechas que ya existen <span class="caMuted">(nunca por debajo de los lugares ya tomados)</span></span>
                                </label>

                                <label class="caOption">
                                    <input type="checkbox" v-model="deactivateOthers" />
                                    <span>Desactivar horarios del rango que NO estén en esta plantilla <span class="caMuted">(solo si no tienen reservas ni holds)</span></span>
                                </label>

                                <div class="caPreviewBar">
                                    <div class="caPreviewText">{{ previewText }}</div>
                                    <RockButton btnType="primary" @click="generate" :disabled="genBusy || previewTotal === 0">
                                        {{ genBusy ? "Aplicando…" : "Aplicar plantilla" }}
                                    </RockButton>
                                </div>

                                <NotificationBox v-if="genResult" :alertType="genResult.kind" class="caGenResult">
                                    <div>{{ genResult.summary }}</div>
                                    <ul v-if="genResult.warnings.length" class="caWarnList">
                                        <li v-for="(w, i) in genResult.warnings.slice(0, 8)" :key="i">{{ w }}</li>
                                        <li v-if="genResult.warnings.length > 8">… y {{ genResult.warnings.length - 8 }} advertencias más.</li>
                                    </ul>
                                </NotificationBox>
                            </div>

                            <!-- ===== Zona 3: Disponibilidad actual ===== -->
                            <div class="caCard">
                                <div class="caCardTitle">Disponibilidad del rango</div>

                                <div v-if="slotsBusy" class="caMuted caSmall">Cargando…</div>
                                <div v-else-if="slotsError" class="caGenResult">
                                    <NotificationBox alertType="danger">{{ slotsError }}</NotificationBox>
                                </div>
                                <div v-else-if="days.length === 0" class="caEmpty">
                                    No hay disponibilidad creada en este rango. Usa la plantilla de arriba para generarla.
                                </div>

                                <div v-for="d in days" :key="d.occurrenceDate" class="caDay">
                                    <div class="caDayTitle">{{ d.occurrenceDateText }}</div>

                                    <div v-for="s in d.slots" :key="s.slotId" class="caSlotWrap">
                                    <div class="caSlot" :class="{ isInactive: !s.isActive }">
                                        <div class="caSlotMain">
                                            <div class="caSlotName">
                                                {{ s.scheduleName }}
                                                <span v-if="s.isSpecial" class="caBadge caBadgeSpecial">Especial</span>
                                                <span v-if="!s.isActive" class="caBadge caBadgeOff">Inactivo</span>
                                                <span v-else-if="!s.showInApp" class="caBadge caBadgeHidden">Oculto en la app</span>
                                            </div>
                                            <div class="caOccBar">
                                                <div class="caOccFill" :style="{ width: occupancyPercent(s) + '%' }" :class="{ isFull: s.available === 0 }"></div>
                                            </div>
                                            <div class="caSlotStats">
                                                <span>Lugares <b>{{ s.capacity }}</b></span>
                                                <span>Reservados <b>{{ s.reservedCount }}</b></span>
                                                <span>Ingresaron <b>{{ s.checkedInCount }}</b></span>
                                                <span>Holds <b>{{ s.holdCount }}</b></span>
                                                <span :class="s.available === 0 ? 'caStatDanger' : 'caStatOk'">Disponibles <b>{{ s.available }}</b></span>
                                                <span v-if="s.timeText" class="notranslate">Puerta <b>{{ doorRangeText(s) }}</b></span>
                                            </div>
                                        </div>

                                        <div class="caSlotActions">
                                            <button type="button" class="caMiniBtn" :disabled="rowBusy === s.slotId" @click="toggleEditor(s)">
                                                {{ editors[s.slotId] ? "Cerrar" : "Editar" }}
                                            </button>
                                            <button
                                                type="button"
                                                class="caMiniBtn"
                                                :disabled="rowBusy === s.slotId"
                                                @click="toggleFromList(s)">
                                                {{ s.isActive ? "Desactivar" : "Reactivar" }}
                                            </button>
                                        </div>
                                    </div>

                                    <div v-if="editors[s.slotId]" class="caEditor caEditorInList">
                                        <div class="caEditorFields">
                                            <div class="caField">
                                                <label class="caLabel">Lugares</label>
                                                <input type="number" min="0" step="1" v-model.number="editors[s.slotId].capacity" class="caInput" />
                                            </div>
                                            <div class="caField">
                                                <label class="caLabel">La puerta abre a las</label>
                                                <input type="time" step="300" v-model="editors[s.slotId].openTime" class="caInput" :disabled="!config.doorColumnReady || !s.timeText" />
                                            </div>
                                            <div class="caField">
                                                <label class="caLabel">La puerta cierra a las</label>
                                                <input type="time" step="300" v-model="editors[s.slotId].closeTime" class="caInput" :disabled="!config.doorColumnReady || !s.timeText" />
                                            </div>
                                        </div>
                                        <label class="caCheck">
                                            <input type="checkbox" v-model="editors[s.slotId].showInApp" :disabled="!config.doorColumnReady" />
                                            <span>Mostrar en la app de reservas <span class="caMuted">(si lo desmarcas, nadie nuevo puede reservar; quien ya reservó entra igual)</span></span>
                                        </label>
                                        <div v-if="!config.doorColumnReady" class="caSpHint">Para cambiar la puerta o la visibilidad falta preparar la base de datos (TI: script QREVENT_SundayService_SlotSettings.sql).</div>
                                        <div v-if="editorError(s)" class="caSpError notranslate">{{ editorError(s) }}</div>
                                        <div class="caEditorActions">
                                            <button type="button" class="caMiniBtn caMiniBtnSave" :disabled="rowBusy === s.slotId || !!editorError(s)" @click="saveEditor(s)">Guardar</button>
                                            <button type="button" class="caMiniBtn" :disabled="rowBusy === s.slotId || !config.doorColumnReady || !s.timeText" @click="normalEditor(s)">Puerta normal</button>
                                        </div>
                                    </div>
                                    </div>
                                </div>
                            </div>
                        </template>
                    </div>

                    <!-- Toast -->
                    <div v-if="toast.show" class="caToast" :class="toast.kind">
                        {{ toast.message }}
                    </div>
                </div>
            </div>
        </template>
    </Panel>
</template>

<script setup lang="ts">
import { computed, nextTick, onBeforeUnmount, ref, watch } from "vue";
import Panel from "@Obsidian/Controls/panel.obs";
import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
import RockButton from "@Obsidian/Controls/rockButton.obs";
import { Chart } from "@Obsidian/Libs/chart";
import type { ChartOptions } from "@Obsidian/Libs/chart";
import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";

type OptionBag = { value: number; text: string };

type ScheduleBag = {
    id: number;
    name: string;
    dayOfWeek: number;
    dayText: string;
    timeText: string;
};

type InitBag = {
    notAuthorized: boolean;
    configError: string | null;
    campuses: OptionBag[];
    schedules: ScheduleBag[];
    defaultCampusId: number;
    startDate: string;
    endDate: string;
    /** false = falta el script SlotSettings: puerta 15/80 fija y todo visible en la app. */
    doorColumnReady: boolean;
    defaultDoorOpensMinutes: number;
    maxDoorOpensMinutes: number;
    doorClosesMinutes: number;
    minDoorClosesMinutes: number;
    maxDoorClosesMinutes: number;
    registrationWindowDays: number;
    todayIso: string;
};

type SlotBag = {
    slotId: number;
    scheduleId: number;
    scheduleName: string;
    capacity: number;
    reservedCount: number;
    holdCount: number;
    checkedInCount: number;
    available: number;
    isActive: boolean;
    /** Servicio especial de una sola fecha (categoría propia, ver CreateSpecialService). */
    isSpecial: boolean;
    /** Hora de inicio HH:mm del Schedule; "" si no la trae. */
    timeText: string;
    /** Minutos antes del inicio en que abre la puerta (propio o de omisión). */
    doorOpensMinutes: number;
    /** Minutos después del inicio en que cierran la puerta y la reserva (propio o de omisión). */
    doorClosesMinutes: number;
    /** true = apertura o cierre propios; false = usa los valores de omisión. */
    doorIsCustom: boolean;
    /** false = no aparece en la app de reservas (la puerta lo sigue aceptando). */
    showInApp: boolean;
    draftCapacity: number;
};

type ScheduleMetricsBag = {
    scheduleId: number;
    scheduleName: string;
    capacity: number;
    reserved: number;
    checkedIn: number;
    noShow: number;
    pending: number;
    isPast: boolean;
};

type WeekMetricsBag = {
    weekStart: string;
    sundayDate: string;
    label: string;
    isPast: boolean;
    capacity: number;
    reserved: number;
    checkedIn: number;
    noShow: number;
    pending: number;
    schedules: ScheduleMetricsBag[];
};

type DaySlotsBag = {
    occurrenceDate: string;
    occurrenceDateText: string;
    slots: SlotBag[];
};

type TemplateRow = {
    scheduleId: number;
    name: string;
    dayOfWeek: number;
    dayText: string;
    timeText: string;
    include: boolean;
    capacity: number;
    /** false = los horarios que cree la plantilla no aparecen en la app de reservas. */
    showInApp: boolean;
};

const config = useConfigurationValues<InitBag>();
const invokeBlockAction = useInvokeBlockAction();

const campusId = ref<number>(config.defaultCampusId || 0);
// Configuración abre en la semana en curso (lunes a domingo); ver applyConfigWeekPreset(0)
// más abajo. El rango que manda el servidor (hoy → +3 meses) ya no se usa como inicial.
const startDate = ref<string>("");
const endDate = ref<string>("");

// Métricas tiene su propio rango: por omisión la semana en curso (lunes a domingo).
// Así entrar al dashboard no altera el rango de trabajo de Configuración ni al revés.
const metricsStartDate = ref<string>("");
const metricsEndDate = ref<string>("");

/** Lunes de la semana de `d` (las semanas del dashboard van de lunes a domingo). */
function mondayOf(d: Date): Date {
    const m = new Date(d.getFullYear(), d.getMonth(), d.getDate());
    m.setDate(m.getDate() - ((m.getDay() + 6) % 7));
    return m;
}

/** Rango [lunes, domingo] de la semana actual desplazada `offsetWeeks` (0 = esta, -1 = pasada). */
function weekRange(offsetWeeks: number): { start: string; end: string } {
    const mon = mondayOf(new Date());
    mon.setDate(mon.getDate() + offsetWeeks * 7);
    const sun = new Date(mon.getTime());
    sun.setDate(sun.getDate() + 6);
    return { start: toIso(mon), end: toIso(sun) };
}

function applyWeekPreset(offsetWeeks: number): void {
    const r = weekRange(offsetWeeks);
    metricsStartDate.value = r.start;
    metricsEndDate.value = r.end;
}

function applyConfigWeekPreset(offsetWeeks: number): void {
    const r = weekRange(offsetWeeks);
    startDate.value = r.start;
    endDate.value = r.end;
}

applyConfigWeekPreset(0);
applyWeekPreset(0);

/** Los inputs Desde/Hasta editan el rango de la pestaña activa. */
const rangeStart = computed<string>({
    get: () => activeTab.value === "Métricas" ? metricsStartDate.value : startDate.value,
    set: v => { if (activeTab.value === "Métricas") metricsStartDate.value = v; else startDate.value = v; }
});
const rangeEnd = computed<string>({
    get: () => activeTab.value === "Métricas" ? metricsEndDate.value : endDate.value,
    set: v => { if (activeTab.value === "Métricas") metricsEndDate.value = v; else endDate.value = v; }
});

const templateRows = ref<TemplateRow[]>((config.schedules || []).map(s => ({
    scheduleId: s.id,
    name: s.name,
    dayOfWeek: s.dayOfWeek,
    dayText: s.dayText,
    timeText: s.timeText,
    include: true,
    capacity: 0,
    showInApp: true
})));

const overwriteCapacity = ref<boolean>(true);
const deactivateOthers = ref<boolean>(false);

const days = ref<DaySlotsBag[]>([]);
const slotsBusy = ref<boolean>(false);
const slotsError = ref<string>("");
const genBusy = ref<boolean>(false);
const rowBusy = ref<number>(0);

const genResult = ref<{ kind: "success" | "warning"; summary: string; warnings: string[] } | null>(null);

const toast = ref<{ show: boolean; kind: "success" | "danger"; message: string }>({ show: false, kind: "success", message: "" });
let toastTimer: number | null = null;

function showToast(kind: "success" | "danger", message: string): void {
    toast.value = { show: true, kind, message };
    if (toastTimer != null) {
        window.clearTimeout(toastTimer);
    }
    toastTimer = window.setTimeout(() => {
        toast.value.show = false;
        toastTimer = null;
    }, 2800);
}

// ---- Fechas (parseo local, sin sorpresas de zona horaria) ----

function parseIso(d: string): Date | null {
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(d || "");
    if (!m) {
        return null;
    }
    return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
}

function toIso(d: Date): string {
    const mm = String(d.getMonth() + 1).padStart(2, "0");
    const dd = String(d.getDate()).padStart(2, "0");
    return `${d.getFullYear()}-${mm}-${dd}`;
}

function applyPreset(daysCount: number): void {
    const start = parseIso(startDate.value) || new Date();
    startDate.value = toIso(start);
    const end = new Date(start.getTime());
    end.setDate(end.getDate() + daysCount);
    endDate.value = toIso(end);
}

function countDatesForDow(dow: number, startIso: string, endIso: string): number {
    if (dow < 0) {
        return 0;
    }
    const start = parseIso(startIso);
    const end = parseIso(endIso);
    if (!start || !end || start > end) {
        return 0;
    }
    const offset = (dow - start.getDay() + 7) % 7;
    const first = new Date(start.getTime());
    first.setDate(first.getDate() + offset);
    if (first > end) {
        return 0;
    }
    return 1 + Math.floor((end.getTime() - first.getTime()) / (7 * 86400000));
}

// ---- Vista previa en vivo ----

const previewTotal = computed<number>(() => {
    return templateRows.value
        .filter(r => r.include)
        .reduce((sum, r) => sum + countDatesForDow(r.dayOfWeek, startDate.value, endDate.value), 0);
});

const previewText = computed<string>(() => {
    const included = templateRows.value.filter(r => r.include);
    if (included.length === 0) {
        return "Selecciona al menos un horario.";
    }
    if (previewTotal.value === 0) {
        return "El rango de fechas no contiene días de los horarios seleccionados.";
    }
    return `Se aplicará a ${previewTotal.value} slots (${included.length} horario${included.length === 1 ? "" : "s"} en el rango).`;
});

// ---- Métricas (pestaña dashboard) ----
const tabs = ["Semana normal", "Servicios especiales", "Métricas"];
const activeTab = ref<string>("Semana normal");

const metricsWeeks = ref<WeekMetricsBag[]>([]);
const metricsBusy = ref<boolean>(false);
const metricsError = ref<string>("");
const selectedWeekKey = ref<string>("");

const selectedWeek = computed<WeekMetricsBag | null>(() =>
    metricsWeeks.value.find(w => w.weekStart === selectedWeekKey.value) ?? null);

const weekChartCanvas = ref<HTMLCanvasElement | null>(null);
const scheduleChartCanvas = ref<HTMLCanvasElement | null>(null);
let weekChart: Chart | null = null;
let scheduleChart: Chart | null = null;

// Paleta categórica validada (orden fijo, no se recicla). El texto nunca
// lleva el color de la serie: identidad por swatch/segmento, valores en tinta.
const SERIES = {
    checkedIn: { label: "Ingresaron", color: "#2a78d6" },
    noShow: { label: "No vinieron", color: "#eb6834" },
    pending: { label: "Pendientes", color: "#1baf7a" }
} as const;
const INK = "#111827";
const INK_MUTED = "#6B7280";
const SURFACE = "#FFFFFF";
const GRID = "rgba(17,24,39,.08)";
const FONT = "Roboto, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Arial, sans-serif";

function pct(part: number, whole: number, bare = false): string {
    if (!whole || whole <= 0) {
        return bare ? "—" : "";
    }
    const v = Math.round((part / whole) * 100);
    return bare ? `${v}%` : `· ${v}%`;
}

function applyPastPreset(weeks: number): void {
    const end = new Date();
    const start = new Date(end.getTime());
    start.setDate(start.getDate() - weeks * 7);
    metricsStartDate.value = toIso(start);
    metricsEndDate.value = toIso(end);
}

async function loadMetrics(): Promise<void> {
    if (!campusId.value || !parseIso(metricsStartDate.value) || !parseIso(metricsEndDate.value)) {
        return;
    }
    metricsBusy.value = true;
    metricsError.value = "";
    try {
        const res = await invokeBlockAction<{ weeks: WeekMetricsBag[] }>("GetWeeklyMetrics", {
            bag: { campusId: campusId.value, startDate: metricsStartDate.value, endDate: metricsEndDate.value }
        });
        if (!res.isSuccess || !res.data) {
            metricsError.value = res.errorMessage || "No se pudieron cargar las métricas.";
            metricsWeeks.value = [];
            return;
        }
        metricsWeeks.value = res.data.weeks || [];

        // Semana por omisión: la más reciente ya realizada; si no hay, la última.
        if (!metricsWeeks.value.some(w => w.weekStart === selectedWeekKey.value)) {
            const past = metricsWeeks.value.filter(w => w.isPast);
            const def = past.length > 0 ? past[past.length - 1] : metricsWeeks.value[metricsWeeks.value.length - 1];
            selectedWeekKey.value = def ? def.weekStart : "";
        }
    }
    catch {
        metricsError.value = "No se pudieron cargar las métricas.";
        metricsWeeks.value = [];
    }
    finally {
        metricsBusy.value = false;
        await nextTick();
        renderCharts();
    }
}

type Stack = { labels: string[]; checkedIn: number[]; noShow: number[]; pending: number[] };

function stackFromWeeks(weeks: WeekMetricsBag[]): Stack {
    return {
        labels: weeks.map(w => w.label),
        checkedIn: weeks.map(w => w.checkedIn),
        noShow: weeks.map(w => w.noShow),
        pending: weeks.map(w => w.pending)
    };
}

function stackFromSchedules(items: ScheduleMetricsBag[]): Stack {
    return {
        labels: items.map(m => m.scheduleName),
        checkedIn: items.map(m => m.checkedIn),
        noShow: items.map(m => m.noShow),
        pending: items.map(m => m.pending)
    };
}

/** Índice del dataset que queda arriba de la pila en la barra i (para redondear solo ese extremo). */
function topDatasetIndex(st: Stack, i: number): number {
    if ((st.pending[i] || 0) > 0) return 2;
    if ((st.noShow[i] || 0) > 0) return 1;
    if ((st.checkedIn[i] || 0) > 0) return 0;
    return -1;
}

function buildDatasets(st: Stack): Array<Record<string, unknown>> {
    const order: Array<{ key: keyof typeof SERIES; data: number[] }> = [
        { key: "checkedIn", data: st.checkedIn },
        { key: "noShow", data: st.noShow },
        { key: "pending", data: st.pending }
    ];
    return order.map((s, idx) => ({
        label: SERIES[s.key].label,
        data: s.data,
        backgroundColor: SERIES[s.key].color,
        // Spec: 2px de superficie entre segmentos apilados (gap, no borde).
        borderColor: SURFACE,
        borderWidth: { top: 2, right: 0, bottom: 0, left: 0 },
        borderSkipped: false,
        maxBarThickness: 24,
        // Spec: extremo de dato redondeado (4px), cuadrado en la base. Solo el
        // segmento superior visible de cada pila lleva el redondeo.
        borderRadius: (ctx: { dataIndex: number }) =>
            topDatasetIndex(st, ctx.dataIndex) === idx
                ? { topLeft: 4, topRight: 4, bottomLeft: 0, bottomRight: 0 }
                : 0
    }));
}

function baseOptions(showTotals: boolean, onBarClick?: (index: number) => void): ChartOptions<"bar"> {
    const tick = { color: INK_MUTED, font: { family: FONT, size: 12 } };
    return {
        responsive: true,
        maintainAspectRatio: false,
        animation: { duration: 250 },
        interaction: { mode: "index", intersect: false },
        onClick: (_evt, elements) => {
            if (onBarClick && elements.length > 0) {
                onBarClick(elements[0].index);
            }
        },
        layout: { padding: { top: showTotals ? 20 : 8, right: 4, left: 0, bottom: 0 } },
        scales: {
            x: { stacked: true, grid: { display: false }, border: { color: GRID }, ticks: tick },
            y: {
                stacked: true,
                beginAtZero: true,
                grid: { color: GRID, drawTicks: false },
                border: { display: false },
                ticks: { ...tick, precision: 0, padding: 6 }
            }
        },
        plugins: {
            legend: {
                position: "bottom",
                labels: { color: INK, boxWidth: 10, boxHeight: 10, padding: 14, font: { family: FONT, size: 12 } }
            },
            tooltip: {
                backgroundColor: INK,
                titleColor: "#FFFFFF",
                bodyColor: "#FFFFFF",
                footerColor: "#FFFFFF",
                titleFont: { family: FONT, weight: "bold" },
                bodyFont: { family: FONT },
                footerFont: { family: FONT, weight: "bold" },
                padding: 10,
                boxWidth: 8,
                boxHeight: 8,
                boxPadding: 4,
                callbacks: {
                    footer: items => "Reservados: " + items.reduce((sum, it) => sum + (Number(it.raw) || 0), 0)
                }
            }
        }
    };
}

/** Total de la pila sobre cada barra (solo en la gráfica corta, ≤ 6 barras). */
const stackTotalsPlugin = {
    id: "caStackTotals",
    afterDatasetsDraw(chart: Chart): void {
        const x = chart.scales.x;
        const y = chart.scales.y;
        if (!x || !y) {
            return;
        }
        const n = chart.data.labels?.length ?? 0;
        const ctx = chart.ctx;
        ctx.save();
        ctx.fillStyle = INK;
        ctx.font = `600 12px ${FONT}`;
        ctx.textAlign = "center";
        ctx.textBaseline = "bottom";
        for (let i = 0; i < n; i++) {
            let total = 0;
            chart.data.datasets.forEach((ds, di) => {
                if (chart.isDatasetVisible(di)) {
                    total += Number((ds.data as number[])[i]) || 0;
                }
            });
            if (total > 0) {
                ctx.fillText(String(total), x.getPixelForValue(i), y.getPixelForValue(total) - 4);
            }
        }
        ctx.restore();
    }
};

function upsertChart(
    existing: Chart | null,
    canvas: HTMLCanvasElement | null,
    st: Stack,
    options: ChartOptions<"bar">,
    withTotals: boolean
): Chart | null {
    // El canvas se desmonta al cambiar de pestaña (v-if): si el chart apunta a
    // uno viejo, se destruye y se crea de nuevo sobre el actual.
    if (existing && existing.canvas !== canvas) {
        existing.destroy();
        existing = null;
    }
    if (!canvas) {
        return existing;
    }
    const data = { labels: st.labels, datasets: buildDatasets(st) };
    if (existing) {
        // Chart.js tipa data/options con el tipo de gráfica genérico; el paso por
        // unknown es el patrón que TS exige para asignar nuestro shape concreto.
        existing.data = data as unknown as typeof existing.data;
        existing.options = options as unknown as typeof existing.options;
        existing.update();
        return existing;
    }
    return new Chart(canvas, {
        type: "bar",
        data: data as never,
        options,
        plugins: withTotals ? [stackTotalsPlugin] : []
    });
}

function renderCharts(): void {
    if (activeTab.value !== "Métricas" || metricsWeeks.value.length === 0) {
        return;
    }
    const weeks = metricsWeeks.value;
    weekChart = upsertChart(
        weekChart,
        weekChartCanvas.value,
        stackFromWeeks(weeks),
        baseOptions(false, i => { selectedWeekKey.value = weeks[i]?.weekStart ?? selectedWeekKey.value; }),
        false
    );
    const sched = selectedWeek.value?.schedules ?? [];
    scheduleChart = upsertChart(
        scheduleChart,
        scheduleChartCanvas.value,
        stackFromSchedules(sched),
        baseOptions(true),
        true
    );
}

watch(activeTab, async tab => {
    if (tab === "Servicios especiales") {
        void loadUpcomingSpecials();
        return;
    }
    if (tab === "Métricas") {
        if (metricsWeeks.value.length === 0) {
            await loadMetrics();
        }
        else {
            await nextTick();
            renderCharts();
        }
    }
});

watch(selectedWeekKey, async () => {
    await nextTick();
    renderCharts();
});

watch([campusId, metricsStartDate, metricsEndDate], () => {
    if (activeTab.value === "Métricas") {
        loadMetrics();
    }
    else {
        // Cambió la sede (o el rango de métricas) estando en Configuración: la próxima
        // visita a Métricas recarga.
        metricsWeeks.value = [];
    }
});

onBeforeUnmount(() => {
    weekChart?.destroy();
    scheduleChart?.destroy();
    weekChart = null;
    scheduleChart = null;
});

// ---- Carga de slots ----

async function loadSlots(fillTemplate: boolean): Promise<void> {
    if (!campusId.value || !parseIso(startDate.value) || !parseIso(endDate.value)) {
        return;
    }

    slotsBusy.value = true;
    slotsError.value = "";

    try {
        const res = await invokeBlockAction<{ days: DaySlotsBag[]; templateCapacities: Record<number, number> }>("GetSlots", {
            bag: { campusId: campusId.value, startDate: startDate.value, endDate: endDate.value }
        });

        if (!res.isSuccess || !res.data) {
            slotsError.value = res.errorMessage || "No se pudo cargar la disponibilidad.";
            days.value = [];
            return;
        }

        days.value = (res.data.days || []).map(d => ({
            ...d,
            slots: (d.slots || []).map(s => ({ ...s, draftCapacity: s.capacity }))
        }));

        if (fillTemplate) {
            const caps = res.data.templateCapacities || {};
            for (const row of templateRows.value) {
                const cap = caps[row.scheduleId];
                if (typeof cap === "number") {
                    row.capacity = cap;
                }
            }
        }
    }
    catch {
        slotsError.value = "Error cargando la disponibilidad.";
        days.value = [];
    }
    finally {
        slotsBusy.value = false;
    }
}

watch(campusId, () => {
    genResult.value = null;
    void loadSlots(true);
});

watch([startDate, endDate], () => {
    void loadSlots(false);
});

if (campusId.value) {
    void loadSlots(true);
}

// ---- Aplicar plantilla ----

async function generate(): Promise<void> {
    if (genBusy.value || !campusId.value) {
        return;
    }

    genResult.value = null;
    genBusy.value = true;

    try {
        const res = await invokeBlockAction<{ inserted: number; updated: number; reactivated: number; deactivated: number; skippedLowCapacity: number; skippedSpecialDay: number; warnings: string[] }>("Generate", {
            bag: {
                campusId: campusId.value,
                startDate: startDate.value,
                endDate: endDate.value,
                items: templateRows.value.filter(r => r.include).map(r => ({ scheduleId: r.scheduleId, capacity: r.capacity || 0, showInApp: r.showInApp })),
                overwriteCapacity: overwriteCapacity.value,
                deactivateOthers: deactivateOthers.value
            }
        });

        if (!res.isSuccess || !res.data) {
            genResult.value = { kind: "warning", summary: res.errorMessage || "No se pudo aplicar la plantilla.", warnings: [] };
            return;
        }

        const d = res.data;
        const parts: string[] = [];
        if (d.inserted) parts.push(`${d.inserted} creados`);
        if (d.updated) parts.push(`${d.updated} actualizados`);
        if (d.reactivated) parts.push(`${d.reactivated} reactivados`);
        if (d.deactivated) parts.push(`${d.deactivated} desactivados`);
        if (d.skippedLowCapacity) parts.push(`${d.skippedLowCapacity} omitidos por lugares ya tomados`);
        if (d.skippedSpecialDay) parts.push(`${d.skippedSpecialDay} omitidos por día con servicio especial`);

        const warnings = d.warnings || [];
        genResult.value = {
            kind: warnings.length ? "warning" : "success",
            summary: parts.length ? `Listo: ${parts.join(", ")}.` : "Listo: no había nada que cambiar.",
            warnings
        };

        await loadSlots(false);
    }
    catch {
        genResult.value = { kind: "warning", summary: "Error aplicando la plantilla.", warnings: [] };
    }
    finally {
        genBusy.value = false;
    }
}

// ---- «Visible en la app» de la plantilla (se aplica al instante) ----

const visBusy = ref<number>(0);

/** Fechas de hoy en adelante del horario dentro del rango cargado, y cuántas están ocultas. */
function rowVisibility(row: TemplateRow): { total: number; hidden: number; allVisible: boolean; mixed: boolean } {
    const today = config.todayIso || toIso(new Date());
    let total = 0;
    let hidden = 0;
    for (const d of days.value) {
        if (d.occurrenceDate < today) {
            continue;
        }
        for (const s of d.slots) {
            if (s.scheduleId === row.scheduleId) {
                total++;
                if (!s.showInApp) {
                    hidden++;
                }
            }
        }
    }
    return { total, hidden, allVisible: total === 0 ? row.showInApp : hidden === 0, mixed: hidden > 0 && hidden < total };
}

/** La casilla de la plantilla sigue el estado real: así «Aplicar plantilla» crea las fechas nuevas igual. */
watch(days, () => {
    for (const row of templateRows.value) {
        const v = rowVisibility(row);
        if (v.total > 0) {
            row.showInApp = v.allVisible;
        }
    }
});

async function onRowVisibilityChange(row: TemplateRow, ev: Event): Promise<void> {
    const input = ev.target as HTMLInputElement;
    const show = input.checked;
    row.showInApp = show;

    if (rowVisibility(row).total === 0) {
        showToast("success", show ? "Las fechas que cree la plantilla saldrán en la app." : "Las fechas que cree la plantilla no saldrán en la app.");
        return;
    }

    visBusy.value = row.scheduleId;
    try {
        const res = await invokeBlockAction<{ resultCode: number; changed: number; message: string }>("SetScheduleVisibility", {
            bag: { campusId: campusId.value, scheduleId: row.scheduleId, startDate: startDate.value, endDate: endDate.value, showInApp: show }
        });

        if (res.isSuccess && res.data?.resultCode === 1) {
            showToast("success", `${row.name}: ${res.data.message}`);
        }
        else {
            showToast("danger", res.data?.message || res.errorMessage || "No se pudo cambiar la visibilidad.");
        }
    }
    catch {
        showToast("danger", "Error cambiando la visibilidad.");
    }
    finally {
        visBusy.value = 0;
        // Recarga en cualquier caso: la casilla vuelve a mostrar el estado real.
        await loadSlots(false);
        void loadUpcomingSpecials();
    }
}

// ---- Edición individual ----
// Lugares, puerta y visibilidad se editan con el editor de cada servicio (saveEditor, más abajo).

async function toggleActive(slot: SlotBag): Promise<void> {
    if (rowBusy.value) {
        return;
    }

    rowBusy.value = slot.slotId;
    try {
        const res = await invokeBlockAction<{ resultCode: number; message: string }>("UpdateSlot", {
            bag: { slotId: slot.slotId, isActive: !slot.isActive }
        });

        if (res.isSuccess && res.data?.resultCode === 1) {
            slot.isActive = !slot.isActive;
            showToast("success", slot.isActive ? "Horario reactivado." : "Horario desactivado.");
        }
        else {
            showToast("danger", res.data?.message || res.errorMessage || "No se pudo cambiar el estado.");
        }
    }
    catch {
        showToast("danger", "Error cambiando el estado.");
    }
    finally {
        rowBusy.value = 0;
    }
}

// =====================================================================
// Servicios especiales, editor por servicio (lugares, puerta, visibilidad)
// =====================================================================
// Los valores vienen del servidor (SundayServiceCapacityAdmin.cs), que vuelve a
// validar todo; aquí solo sirven para mostrar y avisar antes de pulsar.
const defaultDoor = config.defaultDoorOpensMinutes || 15;
const maxDoor = config.maxDoorOpensMinutes || 180;
const defaultClose = config.doorClosesMinutes || 80;
const minClose = config.minDoorClosesMinutes || 15;
const maxClose = config.maxDoorClosesMinutes || 360;
const registrationWindowDays = config.registrationWindowDays || 7;
const todayIso = config.todayIso || toIso(new Date());

// ---- Utilidades de hora ----

/** "13:45" → 825 (minutos desde medianoche). */
function timeToMinutes(t: string): number | null {
    const m = /^(\d{1,2}):(\d{2})/.exec(t || "");
    return m ? Number(m[1]) * 60 + Number(m[2]) : null;
}

/** 825 → "13:45" para mostrar. */
function minutesToText(min: number): string {
    const n = ((min % 1440) + 1440) % 1440;
    return `${Math.floor(n / 60)}:${String(n % 60).padStart(2, "0")}`;
}

/** 825 → "13:45" para un <input type="time"> (dos dígitos); "" si cae fuera del día. */
function minutesToInput(min: number): string {
    if (min < 0 || min > 1439) {
        return "";
    }
    return `${String(Math.floor(min / 60)).padStart(2, "0")}:${String(min % 60).padStart(2, "0")}`;
}

function longDate(d: Date): string {
    const text = d.toLocaleDateString("es-GT", { weekday: "long", day: "numeric", month: "long" });
    return text.charAt(0).toUpperCase() + text.slice(1);
}

/** «13:45 a 15:20»: ventana de la puerta de un servicio. */
function doorRangeText(s: { timeText: string; doorOpensMinutes: number; doorClosesMinutes: number }): string {
    const start = timeToMinutes(s.timeText);
    if (start === null) {
        return "";
    }
    return `${minutesToText(start - s.doorOpensMinutes)} a ${minutesToText(start + s.doorClosesMinutes)}`;
}

/** Mensaje si la ventana (en minutos respecto del inicio) no es válida; null si está bien. */
function doorWindowError(start: number, opensBefore: number, closesAfter: number): string | null {
    if (!Number.isFinite(opensBefore) || opensBefore < 0) {
        return "La puerta no puede abrir después de la hora de inicio.";
    }
    if (opensBefore > maxDoor) {
        return `La puerta puede abrir como máximo ${maxDoor / 60} horas antes del inicio.`;
    }
    if (start - opensBefore < 0) {
        return "La puerta no puede abrir antes de la medianoche.";
    }
    if (!Number.isFinite(closesAfter) || closesAfter < minClose) {
        return `La puerta debe cerrar al menos ${minClose} min después del inicio.`;
    }
    if (closesAfter > maxClose) {
        return `La puerta puede cerrar como máximo ${maxClose / 60} horas después del inicio.`;
    }
    if (start + closesAfter > 1439) {
        return "La puerta no puede cerrar después de la medianoche.";
    }
    return null;
}

// ---- Editor de un servicio (lista de la semana y programados) ----

type SlotEditor = { capacity: number; openTime: string; closeTime: string; showInApp: boolean };

const editors = ref<Record<number, SlotEditor>>({});

function toggleEditor(s: SlotBag): void {
    const copy = { ...editors.value };
    if (copy[s.slotId]) {
        delete copy[s.slotId];
    }
    else {
        const start = timeToMinutes(s.timeText);
        copy[s.slotId] = {
            capacity: s.capacity,
            openTime: start === null ? "" : minutesToInput(start - s.doorOpensMinutes),
            closeTime: start === null ? "" : minutesToInput(start + s.doorClosesMinutes),
            showInApp: s.showInApp
        };
    }
    editors.value = copy;
}

function closeEditor(slotId: number): void {
    const copy = { ...editors.value };
    delete copy[slotId];
    editors.value = copy;
}

/** «Puerta normal»: pone en el editor 15 min antes y 1 h 20 min después (se guarda con «Guardar»). */
function normalEditor(s: SlotBag): void {
    const e = editors.value[s.slotId];
    const start = timeToMinutes(s.timeText);
    if (!e || start === null) {
        return;
    }
    e.openTime = minutesToInput(start - defaultDoor);
    e.closeTime = minutesToInput(start + defaultClose);
}

function editorError(s: SlotBag): string | null {
    const e = editors.value[s.slotId];
    if (!e) {
        return null;
    }
    if (!Number.isInteger(Number(e.capacity)) || Number(e.capacity) < 0) {
        return "Los lugares deben ser un número entero.";
    }
    if (Number(e.capacity) < s.reservedCount + s.holdCount) {
        return `No puede haber menos de ${s.reservedCount + s.holdCount} lugares: ya están tomados.`;
    }
    const start = timeToMinutes(s.timeText);
    if (start === null || !config.doorColumnReady) {
        return null;
    }
    const open = timeToMinutes(e.openTime);
    const close = timeToMinutes(e.closeTime);
    if (open === null || close === null) {
        return "Indica a qué hora abre y cierra la puerta.";
    }
    return doorWindowError(start, start - open, close - start);
}

async function saveEditor(s: SlotBag): Promise<void> {
    const e = editors.value[s.slotId];
    if (!e || rowBusy.value || editorError(s)) {
        return;
    }

    const bag: Record<string, unknown> = { slotId: s.slotId };
    const capacity = Number(e.capacity);
    if (capacity !== s.capacity) {
        bag.capacity = capacity;
    }

    const start = timeToMinutes(s.timeText);
    let opens = s.doorOpensMinutes;
    let closes = s.doorClosesMinutes;
    if (config.doorColumnReady && start !== null) {
        opens = start - (timeToMinutes(e.openTime) ?? start);
        closes = (timeToMinutes(e.closeTime) ?? start) - start;
        if (opens !== s.doorOpensMinutes) {
            bag.doorOpensMinutes = opens;
        }
        if (closes !== s.doorClosesMinutes) {
            bag.doorClosesMinutes = closes;
        }
    }
    if (config.doorColumnReady && e.showInApp !== s.showInApp) {
        bag.showInApp = e.showInApp;
    }

    if (Object.keys(bag).length === 1) {
        closeEditor(s.slotId);
        return;
    }

    rowBusy.value = s.slotId;
    try {
        const res = await invokeBlockAction<{ resultCode: number; message: string }>("UpdateSlot", { bag });

        if (res.isSuccess && res.data?.resultCode === 1) {
            s.capacity = capacity;
            s.draftCapacity = capacity;
            s.available = Math.max(0, capacity - s.reservedCount - s.holdCount);
            s.doorOpensMinutes = opens;
            s.doorClosesMinutes = closes;
            s.doorIsCustom = opens !== defaultDoor || closes !== defaultClose;
            s.showInApp = e.showInApp;
            closeEditor(s.slotId);
            showToast("success", "Cambios guardados.");
            void loadUpcomingSpecials();
            void loadSlots(false);
        }
        else {
            showToast("danger", res.data?.message || res.errorMessage || "No se pudo guardar.");
        }
    }
    catch {
        showToast("danger", "Error guardando los cambios.");
    }
    finally {
        rowBusy.value = 0;
    }
}

/** Desactivar/Reactivar desde la lista de la semana: refresca también los programados. */
async function toggleFromList(slot: SlotBag): Promise<void> {
    await toggleActive(slot);
    void loadUpcomingSpecials();
}

/** Desactivar/Reactivar desde «Programados»: refresca también la lista de la semana. */
async function toggleFromUpcoming(slot: SlotBag): Promise<void> {
    await toggleActive(slot);
    void loadUpcomingSpecials();
    void loadSlots(false);
}

// ---- Formulario «Nuevo servicio especial» ----

type KeepSlot = SlotBag & { keep: boolean };

const formOpen = ref<boolean>(false);
const formBusy = ref<boolean>(false);
const formError = ref<string>("");
const createdResult = ref<{ kind: "success" | "warning"; title: string; lines: string[] } | null>(null);

const fDate = ref<string>("");
const fTime = ref<string>("");
const fName = ref<string>("");
const fCap = ref<number>(0);
const fOpensMin = ref<number>(defaultDoor);
const fClosesMin = ref<number>(defaultClose);
const fShow = ref<boolean>(true);
const fDaySlots = ref<KeepSlot[]>([]);
const fDayBusy = ref<boolean>(false);
let fDayRequest = 0;

/** Servicios activos de la fecha: los únicos por los que pregunta el paso 5. */
const fActiveDaySlots = computed<KeepSlot[]>(() => fDaySlots.value.filter(s => s.isActive));

/** Desactivados de la fecha: solo informativos; el formulario nunca los reactiva. */
const fInactiveDayNames = computed<string[]>(() => fDaySlots.value.filter(s => !s.isActive).map(s => s.scheduleName));

const fStart = computed<number | null>(() => timeToMinutes(fTime.value));

/** La puerta se guarda relativa al inicio: si cambias la hora de inicio, la ventana se mueve con ella. */
const fOpenTime = computed<string>({
    get: () => fStart.value === null ? "" : minutesToInput(fStart.value - fOpensMin.value),
    set: v => {
        const m = timeToMinutes(v);
        if (m !== null && fStart.value !== null) {
            fOpensMin.value = fStart.value - m;
        }
    }
});

const fCloseTime = computed<string>({
    get: () => fStart.value === null ? "" : minutesToInput(fStart.value + fClosesMin.value),
    set: v => {
        const m = timeToMinutes(v);
        if (m !== null && fStart.value !== null) {
            fClosesMin.value = m - fStart.value;
        }
    }
});

const fDoorIsCustom = computed<boolean>(() => fOpensMin.value !== defaultDoor || fClosesMin.value !== defaultClose);

function resetFormDoor(): void {
    fOpensMin.value = defaultDoor;
    fClosesMin.value = defaultClose;
}

const fDoorError = computed<string | null>(() =>
    fStart.value === null ? null : doorWindowError(fStart.value, fOpensMin.value, fClosesMin.value));

const fDateLong = computed<string>(() => {
    const d = parseIso(fDate.value);
    return d ? longDate(d) : "";
});

const fNameHasTime = computed<boolean>(() => /\d{1,2}\s*:\s*\d{2}/.test(fName.value || ""));

const fFinalName = computed<string>(() => {
    const label = (fName.value || "").trim() || "Servicio especial";
    return fStart.value === null ? label : `${label} ${minutesToText(fStart.value)} h`;
});

/** Minutos desde medianoche según el reloj del equipo; solo para avisar «ya pasó». */
function nowMinutesLocal(): number {
    const n = new Date();
    return n.getHours() * 60 + n.getMinutes();
}

/** Lo que falta para poder crear (null = listo). */
const fMissing = computed<string | null>(() => {
    if (!campusId.value) {
        return "Elige la sede arriba.";
    }
    if (!parseIso(fDate.value)) {
        return "Falta la fecha (paso 1).";
    }
    if (fDate.value < todayIso) {
        return "Esa fecha ya pasó.";
    }
    if (fStart.value === null) {
        return "Falta la hora de inicio (paso 1).";
    }
    if (fDate.value === todayIso && fStart.value + fClosesMin.value <= nowMinutesLocal()) {
        return "Esa hora ya pasó: la puerta ya habría cerrado.";
    }
    if (fNameHasTime.value) {
        return "Quita la hora del nombre: se agrega sola (paso 2).";
    }
    if (!(Number(fCap.value) > 0)) {
        return "Faltan los lugares (paso 2).";
    }
    if (fDoorError.value) {
        return `${fDoorError.value} (paso 3)`;
    }
    if (!config.doorColumnReady && (fDoorIsCustom.value || !fShow.value)) {
        return "Para cambiar la puerta o la visibilidad falta preparar la base de datos (ver el aviso de arriba).";
    }
    if (fDayBusy.value) {
        return "Cargando los servicios de ese día…";
    }
    return null;
});

const fSummary = computed<string[]>(() => {
    const d = parseIso(fDate.value);
    if (!d || fStart.value === null) {
        return [];
    }
    const lines: string[] = [];
    const open = minutesToText(fStart.value - fOpensMin.value);
    const close = minutesToText(fStart.value + fClosesMin.value);

    lines.push(`«${fFinalName.value}» · ${longDate(d)} · ${fCap.value} lugares.`);

    if (fShow.value) {
        const opens = new Date(d.getTime());
        opens.setDate(opens.getDate() - (registrationWindowDays - 1));
        const opensText = toIso(opens) <= todayIso ? "desde hoy" : `desde el ${longDate(opens).toLowerCase()}`;
        lines.push(`Se podrá reservar en la app ${opensText} hasta las ${close}.`);
    }
    else {
        lines.push("No aparecerá en la app de reservas (nadie podrá reservar); la puerta lo leerá igual.");
    }

    lines.push(`La puerta leerá los QR de ${open} a ${close}.`);

    const off = fActiveDaySlots.value.filter(s => !s.keep).map(s => s.scheduleName);
    if (off.length) {
        lines.push(`Ese día no habrá: ${off.join(", ")}.`);
    }

    return lines;
});

function openForm(): void {
    fDate.value = "";
    fTime.value = "";
    fName.value = "";
    fCap.value = 0;
    fShow.value = true;
    resetFormDoor();
    fDaySlots.value = [];
    formError.value = "";
    createdResult.value = null;
    formOpen.value = true;
}

function closeForm(): void {
    formOpen.value = false;
    formError.value = "";
}

/** Servicios que ya existen en la fecha del formulario (para «¿se mantienen?»). */
async function loadFormDay(): Promise<void> {
    const request = ++fDayRequest;

    if (!campusId.value || !parseIso(fDate.value)) {
        fDaySlots.value = [];
        fDayBusy.value = false;
        return;
    }

    fDayBusy.value = true;

    try {
        const res = await invokeBlockAction<{ days: DaySlotsBag[] }>("GetSlots", {
            bag: { campusId: campusId.value, startDate: fDate.value, endDate: fDate.value }
        });

        if (request !== fDayRequest) {
            return;
        }

        const slots: KeepSlot[] = [];
        for (const d of (res.isSuccess && res.data ? res.data.days || [] : [])) {
            for (const s of d.slots || []) {
                slots.push({ ...s, draftCapacity: s.capacity, keep: s.isActive });
            }
        }
        slots.sort((a, b) => (timeToMinutes(a.timeText) ?? 9999) - (timeToMinutes(b.timeText) ?? 9999));
        fDaySlots.value = slots;
    }
    catch {
        if (request === fDayRequest) {
            fDaySlots.value = [];
        }
    }
    finally {
        if (request === fDayRequest) {
            fDayBusy.value = false;
        }
    }
}

watch([campusId, fDate], () => {
    void loadFormDay();
});

async function createSpecial(): Promise<void> {
    if (formBusy.value || fMissing.value) {
        return;
    }

    formBusy.value = true;
    formError.value = "";

    try {
        const res = await invokeBlockAction<{ resultCode: number; message: string }>("CreateSpecialService", {
            bag: {
                campusId: campusId.value,
                date: fDate.value,
                time: fTime.value,
                name: (fName.value || "").trim(),
                capacity: Number(fCap.value),
                doorOpensMinutes: fOpensMin.value === defaultDoor ? null : fOpensMin.value,
                doorClosesMinutes: fClosesMin.value === defaultClose ? null : fClosesMin.value,
                showInApp: fShow.value
            }
        });

        if (!res.isSuccess || res.data?.resultCode !== 1) {
            formError.value = res.data?.message || res.errorMessage || "No se pudo crear el servicio especial.";
            return;
        }

        // Servicio creado: ahora se desactivan, uno por uno, los servicios activos marcados «No habrá».
        // Solo desactiva: nunca reactiva nada.
        const lines: string[] = [];
        let failed = false;
        for (const s of fActiveDaySlots.value.filter(x => !x.keep)) {
            try {
                const r = await invokeBlockAction<{ resultCode: number; message: string }>("UpdateSlot", {
                    bag: { slotId: s.slotId, isActive: false }
                });
                if (r.isSuccess && r.data?.resultCode === 1) {
                    lines.push(`Se desactivó ${s.scheduleName}.`);
                }
                else {
                    failed = true;
                    lines.push(`${s.scheduleName}: ${r.data?.message || r.errorMessage || "no se pudo cambiar"}`);
                }
            }
            catch {
                failed = true;
                lines.push(`${s.scheduleName}: error al cambiarlo.`);
            }
        }

        createdResult.value = { kind: failed ? "warning" : "success", title: res.data.message, lines };
        formOpen.value = false;
        showToast("success", "Servicio especial creado.");
    }
    catch {
        formError.value = "Error creando el servicio especial.";
    }
    finally {
        formBusy.value = false;
        void loadUpcomingSpecials();
        void loadSlots(false);
    }
}

// ---- Línea de tiempo del día del formulario ----

type TimelineItem = { key: string; name: string; active: boolean; special: boolean; preview: boolean; start: number; open: number; close: number };

const timelineItems = computed<TimelineItem[]>(() => {
    const items: TimelineItem[] = [];

    for (const s of fDaySlots.value) {
        const start = timeToMinutes(s.timeText);
        if (start === null) {
            continue;
        }
        items.push({ key: `s${s.slotId}`, name: s.scheduleName, active: s.isActive && s.keep, special: s.isSpecial, preview: false, start, open: start - s.doorOpensMinutes, close: start + s.doorClosesMinutes });
    }

    if (fStart.value !== null && !fDoorError.value) {
        items.push({ key: "new", name: fFinalName.value, active: true, special: true, preview: true, start: fStart.value, open: fStart.value - fOpensMin.value, close: fStart.value + fClosesMin.value });
    }

    return items.sort((a, b) => a.start - b.start);
});

/** Eje: horas completas con 30 min de margen. */
const timelineRange = computed<{ min: number; max: number } | null>(() => {
    const items = timelineItems.value;
    if (items.length === 0) {
        return null;
    }
    const min = Math.max(0, Math.floor((Math.min(...items.map(i => i.open)) - 30) / 60) * 60);
    const max = Math.min(1440, Math.ceil((Math.max(...items.map(i => i.close)) + 30) / 60) * 60);
    return { min, max: Math.max(max, min + 120) };
});

const timelineTicks = computed<Array<{ label: string; left: number }>>(() => {
    const r = timelineRange.value;
    if (!r) {
        return [];
    }
    const span = r.max - r.min;
    const step = span > 12 * 60 ? 120 : 60;
    const ticks: Array<{ label: string; left: number }> = [];
    for (let t = r.min; t <= r.max; t += step) {
        ticks.push({ label: minutesToText(t), left: ((t - r.min) / span) * 100 });
    }
    return ticks;
});

const timelineRows = computed(() => {
    const r = timelineRange.value;
    if (!r) {
        return [];
    }
    const span = r.max - r.min;
    return timelineItems.value.map(i => ({
        key: i.key,
        name: i.name,
        active: i.active,
        special: i.special,
        preview: i.preview,
        left: ((i.open - r.min) / span) * 100,
        width: ((i.close - i.open) / span) * 100,
        startPct: ((i.start - i.open) / (i.close - i.open)) * 100,
        hoursText: `${minutesToText(i.open)}–${minutesToText(i.close)}`,
        title: `Puerta de ${minutesToText(i.open)} a ${minutesToText(i.close)} · inicio ${minutesToText(i.start)}`
    }));
});

/** ¿Dos puertas abiertas a la vez? Solo informativo: el escáner valida cada QR con su propio servicio. */
const hasOverlap = computed<boolean>(() => {
    const active = timelineItems.value.filter(i => i.active).sort((a, b) => a.open - b.open);
    for (let i = 1; i < active.length; i++) {
        if (active[i].open < active[i - 1].close) {
            return true;
        }
    }
    return false;
});

// ---- Programados (servicios especiales desde hoy) ----

type UpcomingSpecialBag = SlotBag & { occurrenceDate: string; occurrenceDateText: string };

const upcomingSpecials = ref<UpcomingSpecialBag[]>([]);
const upcomingBusy = ref<boolean>(false);
let upcomingRequest = 0;

async function loadUpcomingSpecials(): Promise<void> {
    const request = ++upcomingRequest;

    if (!campusId.value) {
        upcomingSpecials.value = [];
        upcomingBusy.value = false;
        return;
    }

    upcomingBusy.value = true;

    try {
        const res = await invokeBlockAction<UpcomingSpecialBag[]>("GetUpcomingSpecialServices", {
            bag: { campusId: campusId.value, startDate: todayIso, endDate: todayIso }
        });

        if (request === upcomingRequest) {
            upcomingSpecials.value = res.isSuccess && res.data ? res.data.map(s => ({ ...s, draftCapacity: s.capacity })) : [];
        }
    }
    catch {
        if (request === upcomingRequest) {
            upcomingSpecials.value = [];
        }
    }
    finally {
        if (request === upcomingRequest) {
            upcomingBusy.value = false;
        }
    }
}

watch(campusId, () => {
    editors.value = {};
    void loadUpcomingSpecials();
});

if (campusId.value) {
    void loadUpcomingSpecials();
}

function occupancyPercent(slot: SlotBag): number {
    if (slot.capacity <= 0) {
        return 0;
    }
    return Math.min(100, Math.round(((slot.reservedCount + slot.holdCount) / slot.capacity) * 100));
}

onBeforeUnmount(() => {
    if (toastTimer != null) {
        window.clearTimeout(toastTimer);
        toastTimer = null;
    }
});
</script>

<style>
:root {
    --ca-font: Roboto, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    --ca-bg: #F4F6FB;
    --ca-surface: #FFFFFF;
    --ca-text: #111827;
    --ca-muted: #6B7280;
    --ca-border: rgba(17,24,39,.10);
    --ca-radius: 14px;
    --ca-accent: #2563EB;
    --ca-ok: #10B981;
    --ca-danger: #EF4444;
}

.panel-block .panel-heading,
.panel-block .panel-header { display: none !important; }
.panel-block { background: transparent !important; border: none !important; box-shadow: none !important; }

.caPage {
    font-family: var(--ca-font);
    background: var(--ca-bg);
    min-height: 100vh;
    color: var(--ca-text);
    padding-bottom: 24px;
}

.caTopBar {
    height: 54px;
    display: flex;
    align-items: center;
    padding: 0 16px;
    border-bottom: 1px solid rgba(17,24,39,.06);
}

.caBrand { font-weight: 800; font-size: 17px; }

.caContainer {
    max-width: 980px;
    margin: 0 auto;
    padding: 12px 10px 24px;
}

.caCard {
    background: var(--ca-surface);
    border: 1px solid var(--ca-border);
    border-radius: var(--ca-radius);
    box-shadow: 0 6px 18px rgba(17,24,39,.06);
    padding: 16px;
    margin-bottom: 14px;
}

.caCardTitle { font-weight: 900; font-size: 15px; margin-bottom: 2px; }
.caCardSub { font-size: 12px; color: var(--ca-muted); margin-bottom: 12px; }

/* Contexto */
.caContext {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr auto;
    gap: 12px;
    align-items: end;
    position: sticky;
    top: 0;
    z-index: 20;
}

@media (max-width: 720px) {
    .caContext { grid-template-columns: 1fr 1fr; position: static; }
}

.caField { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.caLabel { font-size: 11px; font-weight: 800; color: var(--ca-muted); text-transform: uppercase; letter-spacing: .4px; }

.caSelect, .caInput {
    height: 40px;
    border: 1px solid var(--ca-border);
    border-radius: 10px;
    padding: 0 10px;
    font-family: var(--ca-font);
    font-size: 14px;
    background: var(--ca-surface);
    color: var(--ca-text);
    width: 100%;
}

.caPresets { display: flex; gap: 6px; align-items: center; padding-bottom: 4px; }

.caChip {
    border: 1px solid var(--ca-border);
    background: var(--ca-surface);
    border-radius: 999px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
}
.caChip:hover { border-color: rgba(37,99,235,.45); color: var(--ca-accent); }

.caEmpty {
    text-align: center;
    color: var(--ca-muted);
    font-size: 13px;
    padding: 28px 12px;
}

/* Plantilla */
.caTplRows { display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }

.caTplRow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--ca-border);
