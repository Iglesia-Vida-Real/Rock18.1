.caSegBtn:focus-visible { outline: 2px solid var(--ca-accent); outline-offset: 1px; }
.caSegBtn.isActive {
    background: var(--ca-surface);
    color: var(--ca-text);
    box-shadow: 0 1px 2px rgba(17,24,39,.12);
}
.caEmptyAction { margin-top: 10px; }
.caMetricsHead { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
.caWeekPick { display: flex; flex-direction: column; gap: 4px; min-width: 160px; }
.caSelectSm { height: 34px; font-size: 13px; }
.caKpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
@media (max-width: 720px) { .caKpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.caKpi {
    border: 1px solid var(--ca-border);
    border-radius: 10px;
    padding: 12px 14px;
    background: var(--ca-surface);
}
.caKpiValue {
    font-size: 28px;
    font-weight: 800;
    line-height: 1.1;
    color: var(--ca-text);
    display: flex;
    align-items: center;
    gap: 8px;
}
.caKpiLabel { margin-top: 4px; font-size: 12px; font-weight: 700; color: var(--ca-text); }
.caKpiSub { font-weight: 400; color: var(--ca-muted); }
.caSwatch { display: inline-block; width: 10px; height: 10px; border-radius: 2px; flex: 0 0 auto; }
/* Alto = área de trazo + banda del eje X + leyenda; nunca un scroll interno. */
.caChartWrap { position: relative; height: 320px; }
.caChartWrapShort { height: 280px; }
.caTableWrap { overflow-x: auto; }
.caTable { width: 100%; border-collapse: collapse; font-size: 13px; }
.caTable th, .caTable td { padding: 8px 10px; border-bottom: 1px solid var(--ca-border); text-align: left; }
.caTable th { font-size: 11px; font-weight: 800; color: var(--ca-muted); text-transform: uppercase; letter-spacing: .4px; }
.caTable .num { text-align: right; font-variant-numeric: tabular-nums; }
.caTable tfoot td { font-weight: 800; border-bottom: none; }

.caSlotActions { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }

.caMiniBtn {
    border: 1px solid var(--ca-border);
    background: #F3F4F6;
    color: #374151;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
}
.caMiniBtn:hover:not(:disabled) { background: #E5E7EB; }
.caMiniBtn:disabled { opacity: .5; cursor: default; }
.caMiniBtnSave { background: #272B32; border-color: #272B32; color: #fff; }
.caMiniBtnSave:hover:not(:disabled) { background: #1a1d22; }

/* Botón primario estilo VidaReal */
.caPage .btn-primary { background-color: #272B32 !important; border-color: #272B32 !important; font-weight: 700; }
.caPage .btn-primary:hover { background-color: #1a1d22 !important; border-color: #1a1d22 !important; }

/* Toast */
.caToast {
    position: fixed;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    z-index: 10000;
    max-width: 420px;
    width: calc(100% - 24px);
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 13px;
    font-weight: 800;
    background: var(--ca-surface);
    border: 1px solid var(--ca-border);
    box-shadow: 0 18px 40px rgba(17,24,39,.18);
}
.caToast.success { border-left: 6px solid rgba(16,185,129,.65); }
.caToast.danger { border-left: 6px solid rgba(239,68,68,.65); }
/* ===== Servicios especiales y editor por servicio (2026-11-23) ===== */
