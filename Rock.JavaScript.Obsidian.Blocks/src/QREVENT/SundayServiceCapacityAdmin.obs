.caBadgeWarn { background: rgba(245,158,11,.12); color: #B45309; border: 1px solid rgba(245,158,11,.35); }

/* Servicio especial */
.caSpecialCard .caCardTitle { display: flex; align-items: center; gap: 8px; }
.caSpecialGrid {
    display: grid;
