.caSpecialDayRow.isConflict .caSpecialDayName { color: #B45309; }
.caSpecialDayName { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 13px; font-weight: 700; min-width: 0; }
.caUpcomingDate { font-weight: 800; text-transform: capitalize; min-width: 110px; }
.caUpcomingActions { display: flex; gap: 6px; flex-shrink: 0; }
.caHowTo { margin-top: 12px; font-size: 12px; color: var(--ca-muted); }
.caHowTo summary { cursor: pointer; font-weight: 700; color: var(--ca-text); }
.caHowTo ol, .caHowTo ul { margin: 8px 0 6px; padding-left: 18px; }
.caHowTo li { margin-bottom: 4px; }
.caHowTo p { margin: 0; }

/* Planificar un día */
.caSpecialGrid { grid-template-columns: 1fr 2fr 1fr 1fr; margin-top: 4px; }
