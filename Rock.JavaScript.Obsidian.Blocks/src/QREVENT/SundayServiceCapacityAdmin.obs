@media (max-width: 720px) {
    .caSpFields, .caSpFields:has(.caFieldWide), .caEditorFields { grid-template-columns: 1fr 1fr; max-width: none; }
    .caSpCardRow { flex-direction: column; align-items: stretch; }
    .caSpCardDate { min-width: 0; }
    .caKeepRow { grid-template-columns: 1fr; }
    .caTplRight { justify-content: space-between; width: 100%; }
